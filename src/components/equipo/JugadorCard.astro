---
// src/components/equipo/JugadorCard.astro
import { fotoJugador, posicionLabel } from "@/lib/equipo-temporada.js";

interface Props {
  convocatoria: any; // { dorsal, jugadores: {...} }
}

const { convocatoria: c } = Astro.props;

const foto = fotoJugador(c.jugadores, "accion");
const posicion =
  posicionLabel[c.jugadores?.posicion] ?? c.jugadores?.posicion ?? "—";
---

<a href={`/jugadores/${c.jugadores?.id}`} class="jugador-card">
  {
    foto ? (
      <img
        src={foto}
        alt={`Foto de ${c.jugadores?.nombre ?? ""} ${c.jugadores?.apellido ?? ""}`}
        class="jugador-img"
        loading="lazy"
      />
    ) : (
      <img
        src="/avatar.svg"
        alt="Avatar por defecto"
        class="jugador-img avatar-placeholder"
      />
    )
  }
  <div class="card-content">
    <span class="dorsal-pill">{c.dorsal ?? "—"}</span>
    <h3>
      <span class="nombre">{c.jugadores?.nombre}</span>
      <span class="apellido">{c.jugadores?.apellido}</span>
    </h3>
    <span class="position">{posicion}</span>
  </div>
</a>

<style>
  .jugador-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    width: 100%;
    min-height: 500px;
    padding-bottom: 1rem;
    background-image: linear-gradient(
      180deg,
      var(--myColor1) 50%,
      var(--myColor2)
    );
    --myColor1: transparent;
    --myColor2: #ff6c0e;
    transition:
      --myColor1 0.3s,
      --myColor2 0.3s,
      transform 0.2s ease;
    border-radius: 1rem;
    color: white;
    text-decoration: none;
    overflow: hidden;
  }
  .jugador-card:hover {
    --myColor1: var(--orange, #f97316);
    --myColor2: var(--orange, #f97316);
    transform: translateY(-3px);
  }
  @property --myColor1 {
    syntax: "<color>";
    initial-value: transparent;
    inherits: false;
  }
  @property --myColor2 {
    syntax: "<color>";
    initial-value: #ff6c0e;
    inherits: false;
  }
  .jugador-card:hover .jugador-img {
    transform: scale(1.05) translate(-50%, -50%);
  }
  .jugador-img {
    position: absolute;
    object-fit: contain;
    -webkit-mask-image: linear-gradient(180deg, black 30%, transparent 85%);
    mask-image: linear-gradient(180deg, black 30%, transparent 85%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 100%;
    width: 100%;
    padding: 1rem;
    transition: transform 0.3s ease-in-out;
    z-index: 0;
  }
  .card-content {
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    gap: 0.2rem;
  }
  .dorsal-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 28px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: white;
    font-weight: 800;
    font-size: 0.85rem;
    padding: 0 0.7rem;
    margin-bottom: 0.45rem;
    backdrop-filter: blur(3px);
  }
  .card-content h3 {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    text-align: center;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.08rem;
    margin: 0;
    line-height: 1.1;
  }
  .nombre {
    font-weight: 300;
    opacity: 0.9;
  }
  .apellido {
    font-weight: 600;
  }
  .position {
    text-transform: uppercase;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    font-weight: 700;
    opacity: 0.95;
  }

  @media (max-width: 640px) {
    .jugador-card {
      min-height: 360px;
    }
    .card-content h3 {
      font-size: 1rem;
    }
  }
</style>
