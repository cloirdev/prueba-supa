---
// src/components/equipo/EquipoHero.astro
import { competicionesDe } from "@/lib/equipo-temporada.js";
import TabsNav from "./TabsNav.astro";

interface Props {
  equipo: any; // equipos[0]
  categoriaNombre: string;
  categoriaSlug: string;
  temporadaSlug: string;
  temporadasOrdenadas: { slug: string; nombre: string }[];
  nombreTransicion: string;
}

const {
  equipo,
  categoriaNombre,
  categoriaSlug,
  temporadaSlug,
  temporadasOrdenadas,
  nombreTransicion,
} = Astro.props;

const competiciones = competicionesDe(equipo ?? {});
---

<div
  class="equipo-hero"
  style={`background-image:
    linear-gradient(
      to bottom,
      rgba(0,0,0,0.35),
      rgba(0,0,0,0.88)
    ),
    url('${equipo?.foto_url || "/placeholder-team.jpg"}')`}
  transition:name={nombreTransicion}
>
  <div class="equipo-hero-inner">
    <a
      href={`/equipos?temporada=${encodeURIComponent(temporadaSlug)}`}
      class="volver">← Equipos</a
    >
    <div class="hero-content">
      <div class="hero-text">
        <p class="categoria-label">{categoriaNombre}</p>

        <h1 transition:name={`nombre-${nombreTransicion}`}>
          {
            equipo?.sponsors?.nombre
              ? `${equipo.sponsors.nombre} CB Jaca`
              : `CB Jaca ${categoriaNombre}`
          }
        </h1>

        {
          competiciones.length > 0 && (
            <p class="hero-competicion">
              {competiciones.map((c) => c.nombre).join(" · ")}
            </p>
          )
        }
      </div>

      {
        equipo?.sponsors?.logo_url && (
          <div class="hero-logo-wrap">
            <img
              src={equipo.sponsors.logo_url}
              alt={`Logo ${equipo.sponsors.nombre}`}
              class="hero-logo"
            />
          </div>
        )
      }
    </div>

    {
      temporadasOrdenadas.length > 1 && (
        <select
          class="temporada-select"
          onchange={`window.location.href='/equipos/${categoriaSlug}/' + this.value`}
        >
          {temporadasOrdenadas.map((t) => (
            <option value={t.slug} selected={t.slug === temporadaSlug}>
              {t.nombre}
            </option>
          ))}
        </select>
      )
    }

    <TabsNav />
  </div>
</div>

<style>
  .equipo-hero {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: flex-end;
    background-size: cover;
    background-position: center 20%;
    background-repeat: no-repeat;
    padding: 3rem 2rem 0;
    color: white;
  }
  .equipo-hero-inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }
  .volver {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--orange, #f97316);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .hero-content {
    margin-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .hero-text {
    max-width: 720px;
  }
  .categoria-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--orange, #f97316);
    margin-bottom: 0.4rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1;
    margin: 0;
  }
  .hero-competicion {
    margin-top: 1rem;
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
  }
  .hero-logo-wrap {
    width: 172px;
    height: 172px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: linear-gradient(
      180deg,
      rgba(30, 41, 59, 0.92),
      rgba(15, 23, 42, 0.92)
    );
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    flex-shrink: 0;
  }
  .hero-logo {
    width: 140px;
    height: 140px;
    object-fit: contain;
    display: block;
    background: transparent;
    padding: 0;
  }
  .temporada-select {
    margin-top: 2rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.15);
    cursor: pointer;
    outline: none;
  }
  .temporada-select option {
    background: #0f172a;
    color: white;
  }

  @media (max-width: 768px) {
    .equipo-hero {
      min-height: 400px;
      padding: 2rem 1rem 0;
    }
    .hero-content {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-logo {
      max-width: 180px;
      max-height: 100px;
    }
    h1 {
      font-size: 2.4rem;
    }
  }
</style>
