---
// src/components/jugador/TirosGrid.astro
import { nivelPct } from "@/lib/jugador-stats.js";

interface Tiro {
  label: string;
  an: number;
  int: number;
  pct: number;
}

interface Props {
  tiros: Tiro[];
}

const { tiros } = Astro.props;
---

<div class="tiros-grid">
  {
    tiros.map(({ label, an, int: intt, pct }) => (
      <div class="tiro-card">
        <div class="tiro-top">
          <span class={`tiro-pct nivel-${nivelPct(pct)}`}>
            {intt ? `${pct}%` : "—"}
          </span>
          <span class="tiro-detalle">
            {an}-{intt}
          </span>
        </div>
        <div class="tiro-bar-track">
          <div
            class={`tiro-bar-fill nivel-${nivelPct(pct)}`}
            style={`width:${pct}%`}
          />
        </div>
        <div class="tiro-label">{label}</div>
      </div>
    ))
  }
</div>

<style>
  .tiros-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tiro-card {
    background: var(--color-background-secondary);
    border: 1px solid var(--borde);
    border-radius: 10px;
    padding: 0.9rem 1rem;
  }
  .tiro-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .tiro-pct {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--texto);
  }
  .tiro-pct.nivel-alto {
    color: #16a34a;
  }
  .tiro-pct.nivel-medio {
    color: #ca8a04;
  }
  .tiro-pct.nivel-bajo {
    color: #dc2626;
  }
  .tiro-detalle {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .tiro-bar-track {
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: var(--borde);
    overflow: hidden;
    margin-bottom: 0.55rem;
  }
  .tiro-bar-fill {
    height: 100%;
    border-radius: 999px;
    background: var(--naranja);
  }
  .tiro-bar-fill.nivel-alto {
    background: #16a34a;
  }
  .tiro-bar-fill.nivel-medio {
    background: #ca8a04;
  }
  .tiro-bar-fill.nivel-bajo {
    background: #dc2626;
  }
  .tiro-label {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  [data-theme="dark"] .tiro-pct.nivel-alto {
    color: #4ade80;
  }
  [data-theme="dark"] .tiro-pct.nivel-medio {
    color: #fbbf24;
  }
  [data-theme="dark"] .tiro-pct.nivel-bajo {
    color: #f87171;
  }
  [data-theme="dark"] .tiro-bar-fill.nivel-alto {
    background: #4ade80;
  }
  [data-theme="dark"] .tiro-bar-fill.nivel-medio {
    background: #fbbf24;
  }
  [data-theme="dark"] .tiro-bar-fill.nivel-bajo {
    background: #f87171;
  }
</style>
