---
// src/components/jugador/FichaTecnica.astro
import { posicionLabel, genderoCategoriaLabel } from "@/lib/jugador-stats.js";

interface Props {
  jugador: any;
  equipoActual: any;
  temporadasClub: number;
}

const { jugador, equipoActual, temporadasClub } = Astro.props;
---

<div class="card-ficha">
  <h2 class="ficha-titulo">Ficha técnica</h2>
  <dl class="ficha-lista">
    <div class="ficha-fila">
      <dt>Posición</dt>
      <dd>{posicionLabel[jugador.posicion] ?? jugador.posicion ?? "—"}</dd>
    </div>
    {
      equipoActual?.categorias?.genero && (
        <div class="ficha-fila">
          <dt>Categoría</dt>
          <dd>
            {genderoCategoriaLabel[equipoActual.categorias.genero] ??
              equipoActual.categorias.genero}
          </dd>
        </div>
      )
    }
    <div class="ficha-fila">
      <dt>Temporadas en CB Jaca</dt>
      <dd>{temporadasClub || "—"}</dd>
    </div>
  </dl>
</div>

<style>
  .card-ficha {
    background: var(--card);
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 1.5rem;
  }
  .ficha-titulo {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 1rem 0;
    color: var(--texto);
    border-bottom: 2px solid var(--naranja);
    padding-bottom: 0.5rem;
  }
  .ficha-lista {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ficha-fila {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }
  .ficha-fila dt {
    color: var(--muted);
  }
  .ficha-fila dd {
    font-weight: 700;
    color: var(--texto);
    margin: 0;
  }
</style>
