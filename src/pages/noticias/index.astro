---
// src/pages/noticias/index.astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

// ── Parámetros de paginación ───────────────────────────────────────────────
const POR_PAGINA = 12;
const pagina = Math.max(
  1,
  parseInt(Astro.url.searchParams.get("pagina") ?? "1"),
);
const desde = (pagina - 1) * POR_PAGINA;

// ── Noticia destacada (hero) ───────────────────────────────────────────────
const { data: destacada } = await supabase
  .from("noticias")
  .select(
    "id, titulo, subtitulo, img_url, fecha_publicacion, slug, categorias(nombre, slug)",
  )
  .eq("publicada", true)
  .eq("destacada", true)
  .order("fecha_publicacion", { ascending: false })
  .limit(1)
  .single();

// ── Query base de noticias ─────────────────────────────────────────────────
let query = supabase
  .from("noticias")
  .select(
    "id, titulo, subtitulo, img_url, fecha_publicacion, slug, categorias(nombre, slug)",
    { count: "exact" },
  )
  .eq("publicada", true)
  .order("fecha_publicacion", { ascending: false })
  .range(desde, desde + POR_PAGINA - 1);

// Excluir la destacada del listado para no repetir
if (destacada?.id) {
  query = query.neq("id", destacada.id);
}

const { data: noticias, count } = await query;

const totalPaginas = Math.ceil((count ?? 0) / POR_PAGINA);

// ── Helpers ────────────────────────────────────────────────────────────────
function urlNoticia(n) {
  if (!n.fecha_publicacion || !n.slug) return `/noticias/${n.id}`;
  const d = new Date(n.fecha_publicacion);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `/noticias/${y}/${m}/${day}/${n.slug}`;
}

function formatFecha(f) {
  if (!f) return "";
  return new Date(f).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function formatFechaCorta(f) {
  if (!f) return "";
  return new Date(f).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

function iniciales(titulo) {
  return (
    (titulo ?? "CB")
      .split(" ")
      .filter((w) => w.length > 2)
      .slice(0, 2)
      .map((w) => w[0])
      .join("")
      .toUpperCase() || "CB"
  );
}

function paginaUrl(p) {
  const params = new URLSearchParams();
  if (p > 1) params.set("pagina", String(p));
  const qs = params.toString();
  return `/noticias${qs ? "?" + qs : ""}`;
}

const paginasAMostrar = Array.from(
  { length: totalPaginas },
  (_, i) => i + 1,
).filter((p) => {
  return p === 1 || p === totalPaginas || Math.abs(p - pagina) <= 1;
});

// Creamos una lista con elipsis donde falten números
const itemsPaginacion = [];
let ultimaP = 0;

for (const p of paginasAMostrar) {
  if (ultimaP !== 0 && p - ultimaP > 1) {
    itemsPaginacion.push({ tipo: "elipsis" });
  }
  itemsPaginacion.push({ tipo: "pagina", valor: p });
  ultimaP = p;
}

const mostrarHero = !!destacada;
---

<Layout titulo="Noticias | CB Jaca">
  <!-- ── CABECERA ── -->
  <div class="page-header">
    <div class="page-header-inner">
      <p class="header-eyebrow">Club Baloncesto Jaca</p>
      <h1 class="header-titulo">Noticias</h1>
    </div>
  </div>

  <div class="contenido">
    <!-- ── NOTICIA DESTACADA (hero de retransmisión) ── -->
    {
      mostrarHero && (
        <section class="hero-section">
          <a href={urlNoticia(destacada)} class="hero-card">
            {destacada.img_url ? (
              <img
                src={destacada.img_url}
                alt={destacada.titulo}
                class="hero-img"
              />
            ) : (
              <div class="hero-placeholder">
                <span>{iniciales(destacada.titulo)}</span>
              </div>
            )}
            <div class="hero-scrim" />

            <div class="hero-content">
              <div class="hero-meta">
                <span class="hero-live">
                  <span class="hero-live-dot" />
                  Portada
                </span>
                {destacada.categorias && (
                  <span class="pill-cat">{destacada.categorias.nombre}</span>
                )}
                <time class="hero-fecha">
                  {formatFecha(destacada.fecha_publicacion)}
                </time>
              </div>
              <h2 class="hero-titulo">{destacada.titulo}</h2>
              {destacada.subtitulo && (
                <p class="hero-sub">{destacada.subtitulo}</p>
              )}
              <span class="hero-leer">
                Leer noticia
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path
                    d="M3 8H13M13 8L9 4M13 8L9 12"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </div>
          </a>
        </section>
      )
    }

    <!-- ── GRID DE NOTICIAS ── -->
    {
      noticias && noticias.length > 0 ? (
        <section class="grid-section">
          {mostrarHero && <h2 class="grid-titulo">Últimas noticias</h2>}
          <div class="noticias-grid">
            {noticias.map((n, i) => (
              <a
                href={urlNoticia(n)}
                class:list={[
                  "noticia-card",
                  i === 0 && mostrarHero ? "card-grande" : "",
                ]}
              >
                <div class="card-img-wrap">
                  {n.img_url ? (
                    <img
                      src={n.img_url}
                      alt={n.titulo}
                      class="card-img"
                      loading="lazy"
                    />
                  ) : (
                    <div class="card-placeholder">
                      <span>{iniciales(n.titulo)}</span>
                    </div>
                  )}
                </div>
                <div class="card-body">
                  <div class="card-meta">
                    {n.categorias && (
                      <span class="card-cat">{n.categorias.nombre}</span>
                    )}
                    <time class="card-fecha">
                      {formatFechaCorta(n.fecha_publicacion)}
                    </time>
                  </div>
                  <h3 class="card-titulo">{n.titulo}</h3>
                  {n.subtitulo && <p class="card-sub">{n.subtitulo}</p>}
                </div>
              </a>
            ))}
          </div>
        </section>
      ) : (
        <div class="vacio">
          <div class="vacio-icono" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none">
              <circle
                cx="24"
                cy="24"
                r="19"
                stroke="currentColor"
                stroke-width="2"
              />
              <path
                d="M17 20C17 20 19.5 17 24 17C28.5 17 31 20 31 20"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path
                d="M17 29C17 29 19.5 31 24 31C28.5 31 31 29 31 29"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
            </svg>
          </div>
          <p class="vacio-texto">No hay noticias todavía.</p>
        </div>
      )
    }

    <!-- ── PAGINACIÓN ── -->
    {
      totalPaginas > 1 && (
        <nav class="paginacion" aria-label="Paginación">
          <a
            href={pagina > 1 ? paginaUrl(pagina - 1) : undefined}
            class:list={[
              "pag-btn",
              "pag-prev",
              pagina <= 1 ? "deshabilitado" : "",
            ]}
            aria-disabled={pagina <= 1}
          >
            ← Anterior
          </a>

          <div class="pag-nums">
            {itemsPaginacion.map((item) =>
              item.tipo === "elipsis" ? (
                <span class="pag-elipsis">…</span>
              ) : (
                <a
                  href={paginaUrl(item.valor)}
                  class:list={[
                    "pag-num",
                    item.valor === pagina ? "activo" : "",
                  ]}
                  aria-current={item.valor === pagina ? "page" : undefined}
                >
                  {item.valor}
                </a>
              ),
            )}
          </div>

          <a
            href={pagina < totalPaginas ? paginaUrl(pagina + 1) : undefined}
            class:list={[
              "pag-btn",
              "pag-next",
              pagina >= totalPaginas ? "deshabilitado" : "",
            ]}
            aria-disabled={pagina >= totalPaginas}
          >
            Siguiente →
          </a>
        </nav>
      )
    }
  </div>
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&display=swap");

  :global(body) {
    --hc-titulo: "Barlow Condensed", "Arial Narrow", sans-serif;
  }

  /* ── Cabecera ─────────────────────────────────────────────────────────── */
  .page-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid var(--borde, rgba(255, 255, 255, 0.07));
    padding: 2.25rem 2rem 1.5rem;
    background: color-mix(in srgb, var(--fondo, #0f172a) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }
  .page-header-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .header-eyebrow {
    font-family: var(--hc-titulo);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--naranja, #f97316);
    margin: 0;
  }
  .header-titulo {
    font-family: var(--hc-titulo);
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0.15rem 0 0;
    line-height: 0.95;
  }

  /* ── Contenido ────────────────────────────────────────────────────────── */
  .contenido {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.75rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* ── Hero destacada (estilo retransmisión) ───────────────────────────── */
  .hero-section {
    margin: 0 -2rem;
  }
  .hero-card {
    position: relative;
    display: block;
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    aspect-ratio: 16/8;
    min-height: 320px;
    background: var(--card, #1e293b);
    isolation: isolate;
  }
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .hero-card:hover .hero-img {
    transform: scale(1.03);
  }
  .hero-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(249, 115, 22, 0.06) 0 2px,
        transparent 2px 26px
      ),
      linear-gradient(135deg, #1e293b 0%, #0b1220 100%);
  }
  .hero-placeholder span {
    font-family: var(--hc-titulo);
    font-size: 5rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.08);
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(4, 8, 16, 0.94) 0%,
      rgba(4, 8, 16, 0.55) 42%,
      transparent 75%
    );
  }
  .hero-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.25rem clamp(1.25rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    border-left: 3px solid var(--naranja, #f97316);
    margin-left: clamp(1.25rem, 4vw, 2.75rem);
    padding-left: 1.1rem;
    max-width: 640px;
  }
  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .hero-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: white;
    background: var(--naranja, #f97316);
    padding: 4px 9px 4px 7px;
    border-radius: 4px;
  }
  .hero-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: white;
    animation: pulso 1.6s ease-in-out infinite;
  }
  @keyframes pulso {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  .pill-cat {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 4px 9px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }
  .hero-fecha {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
  }
  .hero-titulo {
    font-family: var(--hc-titulo);
    font-size: clamp(1.6rem, 4.2vw, 2.75rem);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1.02;
    letter-spacing: -0.005em;
    margin: 0;
    color: white;
  }
  .hero-sub {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-leer {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--naranja, #f97316);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: 0.35rem;
  }
  .hero-leer svg {
    width: 14px;
    height: 14px;
    transition: transform 0.2s ease;
  }
  .hero-card:hover .hero-leer svg {
    transform: translateX(3px);
  }

  /* ── Grid ─────────────────────────────────────────────────────────────── */
  .grid-titulo {
    font-family: var(--hc-titulo);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--naranja, #f97316);
    margin: 0 0 1.25rem;
  }

  .noticias-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .noticia-card.card-grande {
    grid-column: span 2;
  }
  .noticia-card.card-grande .card-img-wrap {
    aspect-ratio: 16/9;
  }
  .noticia-card.card-grande .card-titulo {
    font-size: 1.35rem;
  }
  .noticia-card.card-grande .card-sub {
    display: -webkit-box;
  }

  .noticia-card {
    display: flex;
    flex-direction: column;
    background: var(--card, #1e293b);
    border: 1px solid var(--borde, rgba(255, 255, 255, 0.07));
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s,
      transform 0.15s,
      box-shadow 0.2s;
  }
  .noticia-card:hover {
    border-color: rgba(249, 115, 22, 0.5);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -14px rgba(0, 0, 0, 0.55);
  }
  .noticia-card:focus-visible,
  .hero-card:focus-visible,
  .pag-num:focus-visible,
  .pag-btn:focus-visible {
    outline: 2px solid var(--naranja, #f97316);
    outline-offset: 2px;
  }

  .card-img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.03);
  }
  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }
  .noticia-card:hover .card-img {
    transform: scale(1.06);
  }
  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(
        135deg,
        rgba(249, 115, 22, 0.05) 0 2px,
        transparent 2px 22px
      ),
      rgba(255, 255, 255, 0.02);
  }
  .card-placeholder span {
    font-family: var(--hc-titulo);
    font-size: 1.8rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.14);
  }

  .card-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .card-cat {
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--naranja, #f97316);
  }
  .card-fecha {
    font-size: 0.68rem;
    color: var(--muted, #64748b);
    margin-left: auto;
  }
  .card-titulo {
    font-family: var(--hc-titulo);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-sub {
    font-size: 0.8rem;
    color: var(--muted, #64748b);
    margin: 0;
    line-height: 1.5;
    display: none;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Vacío ────────────────────────────────────────────────────────────── */
  .vacio {
    text-align: center;
    padding: 4.5rem 2rem;
    color: var(--muted, #64748b);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .vacio-icono {
    width: 48px;
    height: 48px;
    color: rgba(255, 255, 255, 0.15);
  }
  .vacio-icono svg {
    width: 100%;
    height: 100%;
  }
  .vacio-texto {
    font-size: 0.9rem;
    max-width: 340px;
    margin: 0;
  }

  /* ── Paginación ───────────────────────────────────────────────────────── */
  .paginacion {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--borde, rgba(255, 255, 255, 0.07));
    flex-wrap: wrap;
  }
  .pag-btn {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--naranja, #f97316);
    text-decoration: none;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid rgba(249, 115, 22, 0.3);
    transition:
      background 0.15s,
      opacity 0.15s;
  }
  .pag-btn:hover {
    background: rgba(249, 115, 22, 0.1);
  }
  .pag-btn.deshabilitado {
    pointer-events: none;
    opacity: 0.3;
  }
  .pag-nums {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .pag-num {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 999px;
    color: var(--muted, #64748b);
    border: 1px solid transparent;
    transition: all 0.15s;
  }
  .pag-num:hover {
    border-color: rgba(255, 255, 255, 0.12);
    color: white;
  }
  .pag-num.activo {
    background: var(--naranja, #f97316);
    color: white;
    border-color: var(--naranja, #f97316);
  }
  .pag-elipsis {
    color: var(--muted, #64748b);
    padding: 0 0.25rem;
    font-size: 0.82rem;
  }

  /* ── Movimiento reducido ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .card-img,
    .hero-leer svg,
    .noticia-card,
    .hero-live-dot {
      transition: none !important;
      animation: none !important;
    }
  }

  /* ── Responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .page-header {
      padding: 1.5rem 1.25rem 1.25rem;
    }

    .hero-section {
      margin: 0 -1.25rem;
    }
    .hero-card {
      aspect-ratio: 4/5;
      border-radius: 0;
    }
    .hero-content {
      margin-left: 1.25rem;
      padding: 1.5rem 1.25rem 1.75rem 1rem;
    }

    .noticias-grid {
      grid-template-columns: 1fr 1fr;
    }
    .noticia-card.card-grande {
      grid-column: span 2;
    }
    .card-img-wrap {
      aspect-ratio: 16/9;
    }
  }

  @media (max-width: 480px) {
    .contenido {
      padding: 2rem 1.25rem 3rem;
    }
    .noticias-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .noticia-card.card-grande {
      grid-column: span 1;
    }
    .card-img-wrap {
      aspect-ratio: 16/9;
    }
    .card-sub {
      display: -webkit-box;
    }
  }
</style>
