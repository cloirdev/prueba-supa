---
// src/pages/index.astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

// ── Últimos resultados ────────────────────────────────────────────────────
// ── Últimos resultados (fin de semana más reciente) ────────────────────────
const { data: ultimoPartidoJugado } = await supabase
  .from("partidos")
  .select("fecha")
  .not("puntos_favor", "is", null)
  .order("fecha", { ascending: false })
  .limit(1)
  .maybeSingle();

let ultimosResultados = [];

if (ultimoPartidoJugado?.fecha) {
  const fechaRef = new Date(ultimoPartidoJugado.fecha + "T00:00:00");
  const diaSemana = fechaRef.getDay(); // 0 = domingo, 6 = sábado

  // Retrocedemos hasta el viernes de esa semana
  const diasHastaViernes =
    diaSemana === 0 ? 2 : diaSemana === 6 ? 1 : diaSemana;
  const viernes = new Date(fechaRef);
  viernes.setDate(fechaRef.getDate() - diasHastaViernes);

  // Avanzamos hasta el domingo de esa semana
  const domingo = new Date(viernes);
  domingo.setDate(viernes.getDate() + 2);

  const fmt = (d) => d.toISOString().split("T")[0];

  const { data: resultadosFinde, error: errorResultados } = await supabase
    .from("partidos")
    .select(
      `
      id, es_local, fecha, jornada, ronda, puntos_favor, puntos_contra,
      equipos (sponsors:sponsors!equipos_sponsor_id_fkey(nombre),
        categorias (nombre, slug),
        temporadas!equipos_temporada_id_fkey (nombre)
      ),
      participante_local:participantes!participante_local_id (
        id, nombre_equipo, clubes (nombre, logo_url)
      ),
      participante_visitante:participantes!participante_visitante_id (
        id, nombre_equipo, clubes (nombre, logo_url)
      )
    `,
    )
    .not("puntos_favor", "is", null)
    .gte("fecha", fmt(viernes))
    .lte("fecha", fmt(domingo))
    .order("fecha", { ascending: false });

  if (errorResultados)
    console.error("Error ultimosResultados:", errorResultados);
  ultimosResultados = resultadosFinde ?? [];
}
// ── Próximos partidos ─────────────────────────────────────────────────────
// ── Próximos partidos (próximo fin de semana con partidos) ─────────────────
const hoy = new Date().toISOString().split("T")[0];

const { data: proximoPartidoPendiente } = await supabase
  .from("partidos")
  .select("fecha")
  .is("puntos_favor", null)
  .gte("fecha", hoy)
  .order("fecha", { ascending: true })
  .limit(1)
  .maybeSingle();

let proximosPartidos = [];

if (proximoPartidoPendiente?.fecha) {
  const fechaRef = new Date(proximoPartidoPendiente.fecha + "T00:00:00");
  const diaSemana = fechaRef.getDay(); // 0 = domingo, 6 = sábado

  const diasHastaViernes =
    diaSemana === 0 ? 2 : diaSemana === 6 ? 1 : diaSemana;
  const viernes = new Date(fechaRef);
  viernes.setDate(fechaRef.getDate() - diasHastaViernes);

  const domingo = new Date(viernes);
  domingo.setDate(viernes.getDate() + 2);

  const fmt = (d) => d.toISOString().split("T")[0];

  const { data: proximosData, error: errorProximos } = await supabase
    .from("partidos")
    .select(
      `
      id, es_local, fecha, jornada, ronda,
      equipos (sponsors:sponsors!equipos_sponsor_id_fkey(nombre), categorias (nombre, slug)),
      participante_local:participantes!participante_local_id (
        id, nombre_equipo, clubes(nombre, logo_url)
      ),
      participante_visitante:participantes!participante_visitante_id (
        id, nombre_equipo, clubes(nombre, logo_url)
      )
    `,
    )
    .is("puntos_favor", null)
    .gte("fecha", fmt(viernes))
    .lte("fecha", fmt(domingo))
    .order("fecha", { ascending: true });

  if (errorProximos) console.error("Error proximosPartidos:", errorProximos);
  proximosPartidos = proximosData ?? [];
}

// ── Noticias destacadas (slider) ──────────────────────────────────────────
const { data: noticiasDestacadas } = await supabase
  .from("noticias")
  .select(
    "id, titulo, subtitulo, img_url, fecha_publicacion, slug, categorias(nombre, slug)",
  )
  .eq("publicada", true)
  .eq("destacada", true)
  .order("fecha_publicacion", { ascending: false })
  .limit(6);

const { data: cronicasDestacadas } = await supabase
  .from("cronicas")
  .select(
    `
    id, titulo, img_url, destacada,
    partidos (
      id, es_local, fecha,
      equipos(categorias(nombre, slug)),
      participante_visitante:participantes!participante_visitante_id (nombre_equipo, clubes(nombre))
    )
  `,
  )
  .eq("publicada", true)
  .eq("destacada", true)
  .order("created_at", { ascending: false })
  .limit(3);

const slider = [
  ...(noticiasDestacadas ?? []).map((n) => ({
    id: n.id,
    tipo: "noticia",
    titulo: n.titulo,
    subtitulo: n.subtitulo,
    img_url: n.img_url,
    fecha: n.fecha_publicacion,
    slug: n.slug,
    categoria: n.categorias,
  })),
  ...(cronicasDestacadas ?? []).map((c) => {
    const rival =
      c.partidos?.participante_visitante?.nombre_equipo ??
      c.partidos?.participante_visitante?.clubes?.nombre ??
      "Rival";
    return {
      id: c.id,
      tipo: "cronica",
      titulo: c.titulo ?? `Crónica vs ${rival}`,
      subtitulo: null,
      img_url: c.img_url,
      fecha: c.partidos?.fecha,
      slug: null,
      categoria: c.partidos?.equipos?.categorias,
      partido_id: c.partidos?.id,
    };
  }),
]
  .sort((a, b) => new Date(b.fecha ?? 0) - new Date(a.fecha ?? 0))
  .slice(0, 6);

// ── Grid noticias ─────────────────────────────────────────────────────────
const { data: noticiasGrid } = await supabase
  .from("noticias")
  .select(
    "id, titulo, subtitulo, img_url, fecha_publicacion, slug, categorias(nombre, slug)",
  )
  .eq("publicada", true)
  .order("fecha_publicacion", { ascending: false })
  .limit(6);

const { data: cronicasGrid } = await supabase
  .from("cronicas")
  .select(
    `
    id, titulo, img_url,
    partidos (
      id, es_local, fecha,
      equipos(categorias(nombre, slug)),
      participante_visitante:participantes!participante_visitante_id (nombre_equipo, clubes(nombre))
    )
  `,
  )
  .eq("publicada", true)
  .order("created_at", { ascending: false })
  .limit(4);

const sliderIds = new Set(slider.map((item) => `${item.tipo}-${item.id}`));

const grid = [
  ...(noticiasGrid ?? []).map((n) => ({
    id: n.id,
    tipo: "noticia",
    titulo: n.titulo,
    subtitulo: n.subtitulo,
    img_url: n.img_url,
    fecha: n.fecha_publicacion,
    href: urlNoticia(n),
    categoria: n.categorias,
  })),
  ...(cronicasGrid ?? []).map((c) => {
    const rival =
      c.partidos?.participante_visitante?.nombre_equipo ??
      c.partidos?.participante_visitante?.clubes?.nombre ??
      "Rival";
    return {
      id: c.id,
      tipo: "cronica",
      titulo: c.titulo ?? `Crónica vs ${rival}`,
      subtitulo: null,
      img_url: c.img_url,
      fecha: c.partidos?.fecha,
      href: `/partidos/${c.partidos?.id}`,
      categoria: c.partidos?.equipos?.categorias,
    };
  }),
]
  .filter((item) => !sliderIds.has(`${item.tipo}-${item.id}`))
  .sort((a, b) => new Date(b.fecha ?? 0) - new Date(a.fecha ?? 0))
  .slice(0, 8);

// ── Helpers ───────────────────────────────────────────────────────────────
function urlNoticia(n) {
  if (!n.fecha_publicacion || !n.slug) return `/noticias/${n.id}`;
  const d = new Date(n.fecha_publicacion);
  return `/noticias/${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}/${n.slug}`;
}

function sliderHref(item) {
  if (item.tipo === "cronica") return `/partidos/${item.partido_id}`;
  if (item.slug && item.fecha) {
    const d = new Date(item.fecha);
    return `/noticias/${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}/${item.slug}`;
  }
  return `/noticias/${item.id}`;
}

function formatFechaCorta(f) {
  if (!f) return "";
  const [y, m, d] = f.toString().split("T")[0].split("-");
  const meses = [
    "ene",
    "feb",
    "mar",
    "abr",
    "may",
    "jun",
    "jul",
    "ago",
    "sep",
    "oct",
    "nov",
    "dic",
  ];
  return `${parseInt(d)} ${meses[parseInt(m) - 1]}`;
}

function formatFechaLarga(f) {
  if (!f) return "";
  const [y, m, d] = f.toString().split("T")[0].split("-");
  const meses = [
    "ene",
    "feb",
    "mar",
    "abr",
    "may",
    "jun",
    "jul",
    "ago",
    "sep",
    "oct",
    "nov",
    "dic",
  ];
  const dias = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
  const fecha = new Date(f + "T00:00:00");
  return `${dias[fecha.getDay()]} ${parseInt(d)} ${meses[parseInt(m) - 1]}`;
}

function nombreRival(p) {
  const rival = p.es_local ? p.participante_visitante : p.participante_local;
  return rival?.nombre_equipo ?? rival?.clubes?.nombre ?? "—";
}

function escudoRival(p) {
  const rival = p.es_local ? p.participante_visitante : p.participante_local;
  return rival?.clubes?.logo_url ?? "/escudo.png";
}

function etiquetaJornada(p) {
  if (p.jornada) return `J${p.jornada}`;
  if (p.ronda && p.ronda !== "Amistoso") return p.ronda;
  return "Amistoso";
}

function nombreEquipo(e) {
  return e?.sponsors?.nombre
    ? `${e.sponsors.nombre} CB Jaca`
    : `CB Jaca ${e?.categorias?.nombre ?? ""}`;
}
---

<Layout titulo="Inicio">
  <div class="hero-slider">
    {
      slider.length === 0 ? (
        <div class="hero-static">
          <div class="hero-static-inner">
            <p class="hero-tag">Bienvenido</p>
            <h1>
              Club Baloncesto <span>Jaca</span>
            </h1>
            <p class="hero-sub">Temporada 2025-26</p>
          </div>
        </div>
      ) : (
        <div class="slider-wrap" id="slider">
          {/* Track de slides */}
          <ul class="slides-track" id="slides-track">
            {slider.map((item, i) => (
              <li class="slide-item" data-index={i}>
                {/* Fondo borroso */}
                {item.img_url && (
                  <div
                    class="slide-blur-bg"
                    style={`background-image:url('${item.img_url}')`}
                  />
                )}
                {!item.img_url && (
                  <div class="slide-blur-bg slide-blur-bg--empty" />
                )}
                {/* Gradiente */}
                <div class="slide-gradient" />
                {/* Contenido */}
                <a href={sliderHref(item)} class="slide-link">
                  {item.img_url && (
                    <img
                      src={item.img_url}
                      alt={item.titulo}
                      class="slide-photo"
                      loading={i === 0 ? "eager" : "lazy"}
                    />
                  )}
                  <div class="slide-text">
                    <div class="slide-meta">
                      {item.tipo === "cronica" && (
                        <span class="slide-pill cronica">Crónica</span>
                      )}
                      {item.categoria && (
                        <span class="slide-pill naranja">
                          {item.categoria.nombre}
                        </span>
                      )}
                      <span class="slide-fecha">
                        {formatFechaCorta(item.fecha)}
                      </span>
                    </div>
                    <h2 class="slide-titulo">{item.titulo}</h2>
                    {item.subtitulo && (
                      <p class="slide-subtitulo">{item.subtitulo}</p>
                    )}
                    <span class="slide-cta">Leer más →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          {/* Controles */}
          {slider.length > 1 && (
            <>
              <button
                class="slider-btn slider-prev"
                id="slider-prev"
                aria-label="Anterior"
              >
                ‹
              </button>
              <button
                class="slider-btn slider-next"
                id="slider-next"
                aria-label="Siguiente"
              >
                ›
              </button>
              {/* Dots */}
              <div class="slider-dots" id="slider-dots">
                {slider.map((_, i) => (
                  <button
                    class:list={["dot", i === 0 ? "active" : ""]}
                    data-dot={i}
                    aria-label={`Slide ${i + 1}`}
                  />
                ))}
              </div>
              {/* Barra de progreso */}
              <div class="slider-progress">
                <div class="slider-progress-bar" id="progress-bar" />
              </div>
            </>
          )}
        </div>
      )
    }
  </div>

  <!-- ══ CONTENIDO PRINCIPAL ══ -->
  <div class="page-wrap">
    <div class="main-col">
      <!-- Noticias grid -->
      {
        grid.length > 0 && (
          <section class="seccion">
            <div class="seccion-head">
              <h2 class="seccion-titulo">Últimas noticias</h2>
              <a href="/noticias" class="ver-mas">
                Ver todas →
              </a>
            </div>
            <div class="noticias-grid">
              {grid.map((item, i) => (
                <a
                  href={item.href}
                  class:list={["noticia-card", i === 0 ? "noticia-grande" : ""]}
                >
                  <div class="noticia-img-wrap">
                    {item.img_url ? (
                      <img
                        src={item.img_url}
                        alt={item.titulo}
                        class="noticia-img"
                        loading="lazy"
                      />
                    ) : (
                      <div class="noticia-placeholder">
                        <img src="/escudo-naranja.png" alt="CB Jaca" />
                      </div>
                    )}
                    {item.tipo === "cronica" && (
                      <span class="noticia-badge">Crónica</span>
                    )}
                  </div>
                  <div class="noticia-body">
                    {item.categoria && (
                      <span class="noticia-cat">{item.categoria.nombre}</span>
                    )}
                    <h3 class="noticia-titulo">{item.titulo}</h3>
                    {i === 0 && item.subtitulo && (
                      <p class="noticia-sub">{item.subtitulo}</p>
                    )}
                    <span class="noticia-fecha">
                      {formatFechaCorta(item.fecha)}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
    <!-- ══ SIDEBAR ══ -->
    <aside class="sidebar">
      <!-- Últimos resultados -->
      {
        ultimosResultados.length > 0 && (
          <div class="sidebar-widget">
            <h3 class="widget-titulo">Últimos resultados</h3>
            <div class="widget-lista">
              {ultimosResultados.map((p) => {
                const vic = p.puntos_favor > p.puntos_contra;
                const eq = nombreEquipo(p.equipos);
                const cat = p.equipos?.categorias?.nombre ?? "";

                const izquierda = p.es_local
                  ? {
                      nombre: eq,
                      escudo: "/escudo-naranja.png",
                      pts: p.puntos_favor,
                      propio: true,
                    }
                  : {
                      nombre: nombreRival(p),
                      escudo: escudoRival(p),
                      pts: p.puntos_contra,
                      propio: false,
                    };
                const derecha = p.es_local
                  ? {
                      nombre: nombreRival(p),
                      escudo: escudoRival(p),
                      pts: p.puntos_contra,
                      propio: false,
                    }
                  : {
                      nombre: eq,
                      escudo: "/escudo-naranja.png",
                      pts: p.puntos_favor,
                      propio: true,
                    };

                return (
                  <a href={`/partidos/${p.id}`} class="widget-partido">
                    <div class="widget-cat">
                      {cat} · {etiquetaJornada(p)} · {formatFechaCorta(p.fecha)}
                    </div>
                    <div class="widget-equipos">
                      <div class="widget-equipo">
                        <img
                          src={izquierda.escudo}
                          alt={izquierda.nombre}
                          class="widget-escudo"
                          onerror="this.src='/escudo.png'"
                        />
                        <span
                          class:list={[
                            "widget-eq-nombre",
                            izquierda.propio && "propio",
                          ]}
                        >
                          {izquierda.nombre}
                        </span>
                      </div>
                      <div class="widget-marcador">
                        <span
                          class:list={[
                            "widget-pts",
                            izquierda.pts > derecha.pts ? "win" : "loss",
                          ]}
                        >
                          {izquierda.pts}
                        </span>
                        <span class="widget-sep">–</span>
                        <span
                          class:list={[
                            "widget-pts",
                            derecha.pts > izquierda.pts ? "win" : "loss",
                          ]}
                        >
                          {derecha.pts}
                        </span>
                      </div>
                      <div class="widget-equipo rival">
                        <img
                          src={derecha.escudo}
                          alt={derecha.nombre}
                          class="widget-escudo"
                          onerror="this.src='/escudo.png'"
                        />
                        <span
                          class:list={[
                            "widget-eq-nombre",
                            derecha.propio && "propio",
                          ]}
                        >
                          {derecha.nombre}
                        </span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )
      }

      <!-- Próximos partidos -->
      {
        proximosPartidos.length > 0 && (
          <div class="sidebar-widget">
            <h3 class="widget-titulo">Próximos partidos</h3>
            <div class="widget-lista">
              {proximosPartidos.map((p) => {
                const eq = nombreEquipo(p.equipos);
                const cat = p.equipos?.categorias?.nombre ?? "";
                return (
                  <a href={`/partidos/${p.id}`} class="widget-partido">
                    <div class="widget-cat">
                      {cat} · {etiquetaJornada(p)} · {formatFechaLarga(p.fecha)}
                    </div>
                    <div class="widget-equipos">
                      <div class="widget-equipo">
                        <img
                          src="/escudo-naranja.png"
                          alt="CB Jaca"
                          class="widget-escudo"
                        />
                        <span class="widget-eq-nombre propio">{eq}</span>
                      </div>
                      <span class="widget-vs">vs</span>
                      <div class="widget-equipo rival">
                        <img
                          src={escudoRival(p)}
                          alt={nombreRival(p)}
                          class="widget-escudo"
                          onerror="this.src='/escudo.png'"
                        />
                        <span class="widget-eq-nombre">{nombreRival(p)}</span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        )
      }
    </aside>
  </div>

  <!-- ══ JS SLIDER ══ -->
  <script>
    function initSlider() {
      const track = document.getElementById("slides-track");
      const items = Array.from(document.querySelectorAll(".slide-item"));
      const dots = Array.from(document.querySelectorAll(".dot"));
      const bar = document.getElementById("progress-bar");
      if (!track || items.length === 0) return;

      let current = 0;
      const total = items.length;
      const DURATION = 6000;

      function goTo(n) {
        current = (n + total) % total;
        track.style.transform = `translateX(-${current * 100}%)`;
        dots.forEach((d, i) => d.classList.toggle("active", i === current));
        resetProgress();
      }

      let progressTimer;
      function resetProgress() {
        if (!bar) return;
        clearTimeout(progressTimer);
        bar.style.transition = "none";
        bar.style.width = "0%";
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            bar.style.transition = `width ${DURATION}ms linear`;
            bar.style.width = "100%";
          });
        });
        progressTimer = setTimeout(() => goTo(current + 1), DURATION);
      }

      resetProgress();

      document
        .getElementById("slider-prev")
        ?.addEventListener("click", () => goTo(current - 1));
      document
        .getElementById("slider-next")
        ?.addEventListener("click", () => goTo(current + 1));
      dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));
    }

    initSlider();
    document.addEventListener("astro:page-load", initSlider);
  </script>

  <style>
    .hero-slider {
      width: 100%;
      position: relative;
    }

    .hero-static {
      height: calc(100vh - 56px);
      min-height: 560px;
      background: var(--azul-oscuro, #0f172a);
      display: flex;
      align-items: flex-end;
      color: white;
    }
    .hero-static-inner {
      padding: 3rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
    }
    .hero-tag {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--naranja, #f28241);
      margin-bottom: 0.5rem;
    }
    .hero-static h1 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      font-weight: 900;
      margin: 0 0 0.4rem;
    }
    .hero-static h1 span {
      color: var(--naranja, #f28241);
    }
    .hero-sub {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.4);
    }

    .slider-wrap {
      position: relative;
      height: calc(100vh - 56px);
      min-height: 560px;
      overflow: hidden;
    }

    .slides-track {
      display: flex;
      height: 100%;
      list-style: none;
      margin: 0;
      padding: 0;
      transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
      will-change: transform;
    }

    .slide-item {
      position: relative;
      min-width: 100%;
      height: 100%;
      overflow: hidden;
    }

    .slide-blur-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: blur(24px) brightness(0.4);
      transform: scale(1.1);
      z-index: 0;
      background-color: #0f172a;
    }
    .slide-blur-bg--empty {
      background-color: #0f172a;
    }

    .slide-gradient {
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.92) 0%,
        rgba(0, 0, 0, 0.4) 45%,
