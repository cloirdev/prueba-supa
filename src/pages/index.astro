---
// src/pages/index.astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

// ── Equipos con su temporada más reciente ─────────────────────────────────
const { data: todosEquipos } = await supabase.from("equipos").select(`
    id, sponsor, categoria_id,
    temporadas (nombre),
    categorias (nombre, slug, orden)
  `);

const equiposPorCategoria = new Map();
(todosEquipos ?? []).forEach((e) => {
  const slug = e.categorias?.slug;
  if (!slug) return;
  const prev = equiposPorCategoria.get(slug);
  if (!prev || (e.temporadas?.nombre ?? "") > (prev.temporadas?.nombre ?? "")) {
    equiposPorCategoria.set(slug, e);
  }
});
const equipos = Array.from(equiposPorCategoria.values()).sort(
  (a, b) => (a.categorias?.orden ?? 999) - (b.categorias?.orden ?? 999),
);

// ── Últimos resultados ────────────────────────────────────────────────────
const { data: ultimosResultados } = await supabase
  .from("partidos")
  .select(
    `
    id, rival, es_local, fecha, jornada, ronda,
    puntos_favor, puntos_contra,
    equipos (sponsor, categorias (nombre, slug), temporadas (nombre)),
    equipos_rivales (nombre_equipo, clubes(logo_url))
  `,
  )
  .not("puntos_favor", "is", null)
  .order("fecha", { ascending: false })
  .limit(5);

// ── Próximos partidos ─────────────────────────────────────────────────────
const hoy = new Date().toISOString().split("T")[0];
const { data: proximosPartidos } = await supabase
  .from("partidos")
  .select(
    `
    id, rival, es_local, fecha, jornada, ronda,
    equipos (sponsor, categorias (nombre, slug)),
    equipos_rivales (nombre_equipo, clubes(logo_url))
  `,
  )
  .is("puntos_favor", null)
  .gte("fecha", hoy)
  .order("fecha", { ascending: true })
  .limit(5);

// ── Noticias destacadas (slider) ──────────────────────────────────────────
const { data: noticiasDestacadas } = await supabase
  .from("noticias")
  .select(
    "id, titulo, subtitulo, img_url, fecha_publicacion, slug, categorias(nombre, slug)",
  )
  .eq("publicada", true)
  .eq("destacada", true)
  .order("fecha_publicacion", { ascending: false })
  .limit(6);

const { data: cronicasDestacadas } = await supabase
  .from("cronicas")
  .select(
    `id, titulo, img_url, destacada, partidos (id, rival, fecha, equipos(categorias(nombre, slug)))`,
  )
  .eq("publicada", true)
  .eq("destacada", true)
  .order("created_at", { ascending: false })
  .limit(3);

const slider = [
  ...(noticiasDestacadas ?? []).map((n) => ({
    id: n.id,
    tipo: "noticia",
    titulo: n.titulo,
    subtitulo: n.subtitulo,
    img_url: n.img_url,
    fecha: n.fecha_publicacion,
    slug: n.slug,
    categoria: n.categorias,
  })),
  ...(cronicasDestacadas ?? []).map((c) => ({
    id: c.id,
    tipo: "cronica",
    titulo: c.titulo ?? `Crónica vs ${c.partidos?.rival}`,
    subtitulo: null,
    img_url: c.img_url,
    fecha: c.partidos?.fecha,
    slug: null,
    categoria: c.partidos?.equipos?.categorias,
    partido_id: c.partidos?.id,
  })),
]
  .sort((a, b) => new Date(b.fecha ?? 0) - new Date(a.fecha ?? 0))
  .slice(0, 6);

// ── Grid noticias ─────────────────────────────────────────────────────────
const { data: noticiasGrid } = await supabase
  .from("noticias")
  .select(
    "id, titulo, subtitulo, img_url, fecha_publicacion, slug, categorias(nombre, slug)",
  )
  .eq("publicada", true)
  .order("fecha_publicacion", { ascending: false })
  .limit(6);

const { data: cronicasGrid } = await supabase
  .from("cronicas")
  .select(
    `id, titulo, img_url, partidos (id, rival, fecha, equipos(categorias(nombre, slug)))`,
  )
  .eq("publicada", true)
  .order("created_at", { ascending: false })
  .limit(4);

const sliderIds = new Set(slider.map((item) => `${item.tipo}-${item.id}`));

const grid = [
  ...(noticiasGrid ?? []).map((n) => ({
    id: n.id,
    tipo: "noticia",
    titulo: n.titulo,
    subtitulo: n.subtitulo,
    img_url: n.img_url,
    fecha: n.fecha_publicacion,
    href: urlNoticia(n),
    categoria: n.categorias,
  })),
  ...(cronicasGrid ?? []).map((c) => ({
    id: c.id,
    tipo: "cronica",
    titulo: c.titulo ?? `Crónica vs ${c.partidos?.rival}`,
    subtitulo: null,
    img_url: c.img_url,
    fecha: c.partidos?.fecha,
    href: `/partidos/${c.partidos?.id}`,
    categoria: c.partidos?.equipos?.categorias,
  })),
]
  .filter((item) => !sliderIds.has(`${item.tipo}-${item.id}`)) // ← línea nueva
  .sort((a, b) => new Date(b.fecha ?? 0) - new Date(a.fecha ?? 0))
  .slice(0, 8);

// ── Helpers ───────────────────────────────────────────────────────────────
function urlNoticia(n) {
  if (!n.fecha_publicacion || !n.slug) return `/noticias/${n.id}`;
  const d = new Date(n.fecha_publicacion);
  return `/noticias/${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}/${n.slug}`;
}

function sliderHref(item) {
  if (item.tipo === "cronica") return `/partidos/${item.partido_id}`;
  if (item.slug && item.fecha) {
    const d = new Date(item.fecha);
    return `/noticias/${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}/${item.slug}`;
  }
  return `/noticias/${item.id}`;
}

function formatFechaCorta(f) {
  if (!f) return "";
  const [y, m, d] = f.toString().split("T")[0].split("-");
  const meses = [
    "ene",
    "feb",
    "mar",
    "abr",
    "may",
    "jun",
    "jul",
    "ago",
    "sep",
    "oct",
    "nov",
    "dic",
  ];
  return `${parseInt(d)} ${meses[parseInt(m) - 1]}`;
}

function formatFechaLarga(f) {
  if (!f) return "";
  const [y, m, d] = f.toString().split("T")[0].split("-");
  const meses = [
    "ene",
    "feb",
    "mar",
    "abr",
    "may",
    "jun",
    "jul",
    "ago",
    "sep",
    "oct",
    "nov",
    "dic",
  ];
  const dias = ["dom", "lun", "mar", "mié", "jue", "vie", "sáb"];
  const fecha = new Date(f + "T00:00:00");
  return `${dias[fecha.getDay()]} ${parseInt(d)} ${meses[parseInt(m) - 1]}`;
}

function nombreRival(p) {
  return p.equipos_rivales?.nombre_equipo ?? p.rival;
}
function escudoRival(p) {
  return p.equipos_rivales?.clubes?.logo_url ?? "/escudo.png";
}
function etiquetaJornada(p) {
  if (p.jornada) return `J${p.jornada}`;
  if (p.ronda && p.ronda !== "Amistoso") return p.ronda;
  return "Amistoso";
}
function nombreEquipo(e) {
  return e?.sponsor
    ? `${e.sponsor} CB Jaca`
    : `CB Jaca ${e?.categorias?.nombre ?? ""}`;
}
---

<Layout titulo="Inicio | CB Jaca">
  <!-- ══ SLIDER FULLSCREEN ══ -->
  <div class="hero-slider">
    {
      slider.length === 0 ? (
        <div class="hero-static">
          <div class="hero-static-inner">
            <p class="hero-tag">Bienvenido</p>
            <h1>
              Club Baloncesto <span>Jaca</span>
            </h1>
            <p class="hero-sub">Temporada 2025-26</p>
          </div>
        </div>
      ) : (
        <div class="slider-wrap" id="slider">
          {/* Track de slides */}
          <ul class="slides-track" id="slides-track">
            {slider.map((item, i) => (
              <li class="slide-item" data-index={i}>
                {/* Fondo borroso */}
                {item.img_url && (
                  <div
                    class="slide-blur-bg"
                    style={`background-image:url('${item.img_url}')`}
                  />
                )}
                {!item.img_url && (
                  <div class="slide-blur-bg slide-blur-bg--empty" />
                )}
                {/* Gradiente */}
                <div class="slide-gradient" />
                {/* Contenido */}
                <a href={sliderHref(item)} class="slide-link">
                  {item.img_url && (
                    <img
                      src={item.img_url}
                      alt={item.titulo}
                      class="slide-photo"
                      loading={i === 0 ? "eager" : "lazy"}
                    />
                  )}
                  <div class="slide-text">
                    <div class="slide-meta">
                      {item.tipo === "cronica" && (
                        <span class="slide-pill cronica">Crónica</span>
                      )}
                      {item.categoria && (
                        <span class="slide-pill naranja">
                          {item.categoria.nombre}
                        </span>
                      )}
                      <span class="slide-fecha">
                        {formatFechaCorta(item.fecha)}
                      </span>
                    </div>
                    <h2 class="slide-titulo">{item.titulo}</h2>
                    {item.subtitulo && (
                      <p class="slide-subtitulo">{item.subtitulo}</p>
                    )}
                    <span class="slide-cta">Leer más →</span>
                  </div>
                </a>
              </li>
            ))}
          </ul>

          {/* Controles */}
          {slider.length > 1 && (
            <>
              <button
                class="slider-btn slider-prev"
                id="slider-prev"
                aria-label="Anterior"
              >
                ‹
              </button>
              <button
                class="slider-btn slider-next"
                id="slider-next"
                aria-label="Siguiente"
              >
                ›
              </button>
              {/* Dots */}
              <div class="slider-dots" id="slider-dots">
                {slider.map((_, i) => (
                  <button
                    class:list={["dot", i === 0 ? "active" : ""]}
                    data-dot={i}
                    aria-label={`Slide ${i + 1}`}
                  />
                ))}
              </div>
              {/* Barra de progreso */}
              <div class="slider-progress">
                <div class="slider-progress-bar" id="progress-bar" />
              </div>
            </>
          )}
        </div>
      )
    }
  </div>

  <!-- ══ CONTENIDO PRINCIPAL ══ -->
  <div class="page-wrap">
    <div class="main-col">
      <!-- Noticias grid -->
      {
        grid.length > 0 && (
          <section class="seccion">
            <div class="seccion-head">
              <h2 class="seccion-titulo">Últimas noticias</h2>
              <a href="/noticias" class="ver-mas">
                Ver todas →
              </a>
            </div>
            <div class="noticias-grid">
              {grid.map((item, i) => (
                <a
                  href={item.href}
                  class:list={["noticia-card", i === 0 ? "noticia-grande" : ""]}
                >
                  <div class="noticia-img-wrap">
                    {item.img_url ? (
                      <img
                        src={item.img_url}
                        alt={item.titulo}
                        class="noticia-img"
                        loading="lazy"
                      />
                    ) : (
                      <div class="noticia-placeholder">
                        <img src="/escudo-naranja.png" alt="CB Jaca" />
                      </div>
                    )}
                    {item.tipo === "cronica" && (
                      <span class="noticia-badge">Crónica</span>
                    )}
                  </div>
                  <div class="noticia-body">
                    {item.categoria && (
                      <span class="noticia-cat">{item.categoria.nombre}</span>
                    )}
                    <h3 class="noticia-titulo">{item.titulo}</h3>
                    {i === 0 && item.subtitulo && (
                      <p class="noticia-sub">{item.subtitulo}</p>
                    )}
                    <span class="noticia-fecha">
                      {formatFechaCorta(item.fecha)}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- Equipos -->
      <section class="seccion">
        <div class="seccion-head">
          <h2 class="seccion-titulo">Equipos</h2>
          <a href="/equipos" class="ver-mas">Ver todos →</a>
        </div>
        <div class="equipos-grid">
          {
            equipos.map((e) => {
              const href =
                e.temporadas?.nombre && e.categorias?.slug
                  ? `/equipos/${e.categorias.slug}/${e.temporadas.nombre}`
                  : null;
              const nombre = e.sponsor
                ? `${e.sponsor} CB Jaca`
                : `CB Jaca ${e.categorias?.nombre ?? ""}`;
              return href ? (
                <a href={href} class="equipo-card">
                  <img
                    src="/escudo-naranja.png"
                    alt="CB Jaca"
                    class="equipo-escudo"
                  />
                  <div>
                    <div class="equipo-nombre">{nombre}</div>
                    <div class="equipo-cat">{e.categorias?.nombre}</div>
                  </div>
                  <span class="equipo-arrow">→</span>
                </a>
              ) : (
                <div class="equipo-card equipo-card--off">
                  <img
                    src="/escudo-naranja.png"
                    alt="CB Jaca"
                    class="equipo-escudo"
                  />
                  <div>
                    <div class="equipo-nombre">{nombre}</div>
                    <div class="equipo-cat">{e.categorias?.nombre}</div>
                  </div>
                </div>
              );
            })
          }
        </div>
      </section>
    </div>

    <!-- ══ SIDEBAR ══ -->
    <aside class="sidebar">
      <!-- Últimos resultados -->
      {
        ultimosResultados.map((p) => {
          const vic = p.puntos_favor > p.puntos_contra;
          const eq = nombreEquipo(p.equipos);
          const cat = p.equipos?.categorias?.nombre ?? "";

          // Local → CB Jaca izquierda | Visitante → CB Jaca derecha
          // Elimina pNuestros/pEllos y usa directamente:
          const izquierda = p.es_local
            ? {
                nombre: eq,
                escudo: "/escudo-naranja.png",
                pts: p.puntos_favor,
                propio: true,
              }
            : {
                nombre: nombreRival(p),
                escudo: escudoRival(p),
                pts: p.puntos_contra,
                propio: false,
              };
          const derecha = p.es_local
            ? {
                nombre: nombreRival(p),
                escudo: escudoRival(p),
                pts: p.puntos_contra,
                propio: false,
              }
            : {
                nombre: eq,
                escudo: "/escudo-naranja.png",
                pts: p.puntos_favor,
                propio: true,
              };

          return (
            <a href={`/partidos/${p.id}`} class="widget-partido">
              <div class="widget-cat">
                {cat} · {etiquetaJornada(p)} · {formatFechaCorta(p.fecha)}
              </div>
              <div class="widget-equipos">
                <div class="widget-equipo">
                  <img
                    src={izquierda.escudo}
                    alt={izquierda.nombre}
                    class="widget-escudo"
                    onerror="this.src='/escudo.png'"
                  />
                  <span
                    class:list={[
                      "widget-eq-nombre",
                      izquierda.propio && "propio",
                    ]}
                  >
                    {izquierda.nombre}
                  </span>
                </div>
                <div class="widget-marcador">
                  <span
                    class:list={[
                      "widget-pts",
                      izquierda.pts > derecha.pts ? "win" : "loss",
                    ]}
                  >
                    {izquierda.pts}
                  </span>
                  <span class="widget-sep">–</span>
                  <span
                    class:list={[
                      "widget-pts",
                      derecha.pts > izquierda.pts ? "win" : "loss",
                    ]}
                  >
                    {derecha.pts}
                  </span>
                </div>
                <div class="widget-equipo rival">
                  <img
                    src={derecha.escudo}
                    alt={derecha.nombre}
                    class="widget-escudo"
                    onerror="this.src='/escudo.png'"
                  />
                  <span
                    class:list={[
                      "widget-eq-nombre",
                      derecha.propio && "propio",
                    ]}
                  >
                    {derecha.nombre}
                  </span>
                </div>
              </div>
            </a>
          );
        })
      }

      <!-- Próximos partidos -->
      {
        proximosPartidos && proximosPartidos.length > 0 && (
          <div class="sidebar-widget">
            <h3 class="widget-titulo">Próximos partidos</h3>
            <div class="widget-lista">
              {proximosPartidos.map((p) => {
                const eq = nombreEquipo(p.equipos);
                return (
                  <div class="widget-partido proximo">
                    <div class="widget-equipos">
                      <div class="widget-equipo">
                        <img
                          src="/escudo-naranja.png"
                          alt="CB Jaca"
                          class="widget-escudo"
                        />
                        <span class="widget-eq-nombre">{eq}</span>
                      </div>
                      <div class="widget-vs-fecha">
                        <span class="widget-vs">vs</span>
                        <span class="widget-fecha-proximo">
                          {formatFechaLarga(p.fecha)}
                        </span>
                      </div>
                      <div class="widget-equipo rival">
                        <img
                          src={escudoRival(p)}
                          alt={nombreRival(p)}
                          class="widget-escudo"
                          onerror="this.src='/escudo.png'"
                        />
                        <span class="widget-eq-nombre">{nombreRival(p)}</span>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )
      }
    </aside>
  </div>
</Layout>

<!-- ══ JS SLIDER ══ -->
<script>
  function initSlider() {
    const track = document.getElementById("slides-track");
    const items = Array.from(document.querySelectorAll(".slide-item"));
    const dots = Array.from(document.querySelectorAll(".dot"));
    const bar = document.getElementById("progress-bar");
    if (!track || items.length === 0) return;

    let current = 0;
    const total = items.length;
    const DURATION = 6000;

    function goTo(n) {
      current = (n + total) % total;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle("active", i === current));
      resetProgress();
    }

    // Barra de progreso animada
    let progressTimer;
    function resetProgress() {
      if (!bar) return;
      clearTimeout(progressTimer);
      bar.style.transition = "none";
      bar.style.width = "0%";
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          bar.style.transition = `width ${DURATION}ms linear`;
          bar.style.width = "100%";
        });
      });
      progressTimer = setTimeout(() => goTo(current + 1), DURATION);
    }

    resetProgress();

    document
      .getElementById("slider-prev")
      ?.addEventListener("click", () => goTo(current - 1));
    document
      .getElementById("slider-next")
      ?.addEventListener("click", () => goTo(current + 1));
    dots.forEach((d, i) => d.addEventListener("click", () => goTo(i)));

    // Pausa en hover
    const wrap = document.getElementById("slider");
    wrap?.addEventListener("mouseenter", () => {
      clearTimeout(progressTimer);
      bar && (bar.style.transition = "none");
    });
    wrap?.addEventListener("mouseleave", resetProgress);
  }

  initSlider();
  document.addEventListener("astro:page-load", initSlider);
</script>

<style>
  /* ══ SLIDER ══ */
  .hero-slider {
    width: 100%;
    position: relative;
  }

  .hero-static {
    height: 60vh;
    min-height: 400px;
    background: var(--azul-oscuro, #0f172a);
    display: flex;
    align-items: flex-end;
    color: white;
  }
  .hero-static-inner {
    padding: 3rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }
  .hero-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--naranja, #f28241);
    margin-bottom: 0.5rem;
  }
  .hero-static h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 900;
    margin: 0 0 0.4rem;
  }
  .hero-static h1 span {
    color: var(--naranja, #f28241);
  }
  .hero-sub {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .slider-wrap {
    position: relative;
    height: 82vh;
    min-height: 480px;
    max-height: 820px;
    overflow: hidden;
  }

  .slides-track {
    display: flex;
    height: 100%;
    list-style: none;
    margin: 0;
    padding: 0;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .slide-item {
    position: relative;
    min-width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .slide-blur-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(24px) brightness(0.4);
    transform: scale(1.1);
    z-index: 0;
    background-color: #0f172a;
  }
  .slide-blur-bg--empty {
    background-color: #0f172a;
  }

  .slide-gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.92) 0%,
      rgba(0, 0, 0, 0.4) 45%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  .slide-link {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    width: 100%;
    text-decoration: none;
    color: white;
    box-sizing: border-box;
  }

  .slide-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    z-index: 0;
  }

  .slide-text {
    position: relative;
    z-index: 3;
    padding: 2.5rem 3rem;
    max-width: 760px;
  }

  .slide-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }
  .slide-pill {
    font-size: 0.62rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 3px;
  }
  .slide-pill.naranja {
    background: var(--naranja, #f28241);
