---
// src/pages/jugadores/[id].astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const { data: jugadores } = await supabase.from("jugadores").select("id");

  return (jugadores ?? []).map((j) => ({
    params: { id: j.id },
  }));
}

const { id } = Astro.params;

// ── Datos del jugador ──────────────────────────────────────────────────────
const { data: jugador } = await supabase
  .from("jugadores")
  .select(
    "id, nombre, apellido, posicion, genero, foto_dni_url, foto_accion_url",
  )
  .eq("id", id)
  .single();

if (!jugador) return Astro.redirect("/equipos");

// ── Historial de equipos por temporada ────────────────────────────────────
const { data: historial, error: errorHistorial } = await supabase
  .from("convocatorias_temporada")
  .select(
    `
    dorsal,
    equipos (
      id,
      sponsors ( nombre ),
      categorias ( nombre, slug, genero ),
      temporadas ( id, nombre ),
      equipo_competiciones (
        competiciones ( nombre )
      )
    )
  `,
  )
  .eq("jugador_id", id)
  .order("equipo_id");

if (errorHistorial) console.error("Error historial:", errorHistorial);

// Ordenar historial por temporada más reciente
const historialOrdenado = (historial ?? []).sort((a, b) =>
  (b.equipos?.temporadas?.nombre ?? "").localeCompare(
    a.equipos?.temporadas?.nombre ?? "",
  ),
);

// ── Estadísticas por partido ───────────────────────────────────────────────
const { data: statsPartidos, error: errorStats } = await supabase
  .from("convocatorias_partido")
  .select(
    `
    titular, minutos, puntos, valoracion,
    tiros_campo_intentados, tiros_campo_anotados,
    triples_intentados, triples_anotados,
    tiros_libres_intentados, tiros_libres_anotados,
    rebotes_ofensivos, rebotes_defensivos, rebotes_totales,
    asistencias, robos, tapones, perdidas, faltas_cometidas,
    partidos (
      id, fecha, jornada, ronda, es_local,
      puntos_favor, puntos_contra,
      equipos (
        sponsors ( nombre ),
        categorias ( nombre, slug ),
        temporadas ( nombre )
      ),
      participante_local:participantes!participante_local_id (
        nombre_equipo,
        equipos_rivales ( nombre_equipo )
      ),
      participante_visitante:participantes!participante_visitante_id (
        nombre_equipo,
        equipos_rivales ( nombre_equipo )
      )
    )
  `,
  )
  .eq("jugador_id", id)
  .order("partidos(fecha)", { ascending: false });

if (errorStats) console.error("Error stats:", errorStats);

const stats = statsPartidos ?? [];

// ── Helpers ────────────────────────────────────────────────────────────────
const posicionLabel = {
  Base: "Base",
  Escolta: "Escolta",
  Alero: "Alero",
  "Ala-Pívot": "Ala-Pívot",
  Pívot: "Pívot",
};

function porcentaje(an, intent) {
  if (!intent) return 0;
  return Math.round((an / intent) * 100);
}

function nivelPct(pct) {
  if (pct >= 50) return "alto";
  if (pct >= 35) return "medio";
  return "bajo";
}

function minutosDisplay(totalSegundos) {
  const val = parseInt(totalSegundos) || 0;
  if (val < 200) return `${val}'`;
  const mm = Math.floor(val / 60);
  const ss = val % 60;
  return `${mm}:${String(ss).padStart(2, "0")}`;
}

function formatFecha(f) {
  if (!f) return "—";
  return new Date(f).toLocaleDateString("es-ES", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

function nombreEquipoPropio(eq) {
  return eq?.sponsors?.nombre
    ? `${eq.sponsors.nombre}`
    : `CB Jaca ${eq?.categorias?.nombre ?? ""}`;
}

function nombreCompeticion(eq) {
  return (
    eq?.equipo_competiciones?.[0]?.competiciones?.nombre ??
    eq?.categorias?.nombre ??
    "—"
  );
}

function nombreRival(p) {
  const participanteRival = p?.es_local
    ? p?.participante_visitante
    : p?.participante_local;
  return (
    participanteRival?.nombre_equipo ??
    participanteRival?.equipos_rivales?.nombre_equipo ??
    "Rival"
  );
}

function sum(arr, campo) {
  return arr.reduce((acc, s) => acc + (parseInt(s[campo]) || 0), 0);
}

function normalizar(valor, max) {
  return Math.max(0, Math.min(1, (valor || 0) / max));
}

function puntoEje(indice, total, cx, cy, radio, valor) {
  const angulo = (Math.PI * 2 * indice) / total - Math.PI / 2;
  const x = cx + Math.cos(angulo) * radio * valor;
  const y = cy + Math.sin(angulo) * radio * valor;
  return `${x.toFixed(1)},${y.toFixed(1)}`;
}

function poligonoRadar(valores, cx, cy, radio) {
  return valores
    .map((v, i) => puntoEje(i, valores.length, cx, cy, radio, v))
    .join(" ");
}

function etiquetaEje(indice, total, cx, cy, radio) {
  const angulo = (Math.PI * 2 * indice) / total - Math.PI / 2;
  return {
    x: cx + Math.cos(angulo) * radio,
    y: cy + Math.sin(angulo) * radio,
  };
}

// ── Cálculo de estadísticas ────────────────────────────────────────────────
function computarDatos(statsSeason) {
  const jugados = statsSeason.filter((s) => (s.minutos ?? 0) > 0).length;

  const totales = {
    puntos: sum(statsSeason, "puntos"),
    reb_of: sum(statsSeason, "rebotes_ofensivos"),
    reb_def: sum(statsSeason, "rebotes_defensivos"),
    asistencias: sum(statsSeason, "asistencias"),
    robos: sum(statsSeason, "robos"),
    tapones: sum(statsSeason, "tapones"),
    perdidas: sum(statsSeason, "perdidas"),
    valoracion: sum(statsSeason, "valoracion"),
    minutos: sum(statsSeason, "minutos"),
    tc_an: sum(statsSeason, "tiros_campo_anotados"),
    tc_int: sum(statsSeason, "tiros_campo_intentados"),
    t3_an: sum(statsSeason, "triples_anotados"),
    t3_int: sum(statsSeason, "triples_intentados"),
    tl_an: sum(statsSeason, "tiros_libres_anotados"),
    tl_int: sum(statsSeason, "tiros_libres_intentados"),
  };
  totales.rebotes = totales.reb_of + totales.reb_def;

  const media = (v) => (jugados ? v / jugados : 0);
  const mediaFmt = (v) => (jugados ? (v / jugados).toFixed(1) : "—");

  const medias = {
    puntos: media(totales.puntos),
    rebotes: media(totales.rebotes),
    asistencias: media(totales.asistencias),
    valoracion: media(totales.valoracion),
    defensa: media(totales.robos + totales.tapones),
  };

  const mediasFmt = {
    puntos: mediaFmt(totales.puntos),
    rebotes: mediaFmt(totales.rebotes),
    asistencias: mediaFmt(totales.asistencias),
    valoracion: mediaFmt(totales.valoracion),
    robos: mediaFmt(totales.robos),
    tapones: mediaFmt(totales.tapones),
  };

  let maxPuntos = null;
  let mejorTriples = null;
  let mejorValoracion = null;

  statsSeason.forEach((s) => {
    if (!maxPuntos || (s.puntos ?? 0) > (maxPuntos.puntos ?? 0)) maxPuntos = s;
    if (
      !mejorValoracion ||
      (s.valoracion ?? 0) > (mejorValoracion.valoracion ?? 0)
    )
      mejorValoracion = s;
    if ((s.triples_intentados ?? 0) >= 3) {
      const pct = s.triples_anotados / s.triples_intentados;
      const pctActual = mejorTriples
        ? mejorTriples.triples_anotados / mejorTriples.triples_intentados
        : -1;
      if (pct > pctActual) mejorTriples = s;
    }
  });

  const radar = [
    normalizar(medias.puntos, 22),
    normalizar(medias.rebotes, 12),
    normalizar(medias.asistencias, 7),
    normalizar(medias.defensa, 5),
    normalizar(medias.valoracion, 22),
  ];

  const idMejorPartido = mejorValoracion?.partidos?.id ?? null;

  const partidosOrdenados = [...statsSeason].sort(
    (a, b) =>
      new Date(b.partidos?.fecha ?? 0) - new Date(a.partidos?.fecha ?? 0),
  );

  return {
    jugados,
    totales,
    medias,
    mediasFmt,
    maxPuntos,
    mejorTriples,
    radar,
    idMejorPartido,
    partidos: partidosOrdenados,
  };
}

// ── Agrupación por temporada ────────────────────────────────────────────────
const temporadasSet = new Set();
stats.forEach((s) => {
  const t = s.partidos?.equipos?.temporadas?.nombre;
  if (t) temporadasSet.add(t);
});
const listaTemporadas = [...temporadasSet].sort().reverse();

const opcionesTemporada =
  listaTemporadas.length > 1 ? [...listaTemporadas, "total"] : listaTemporadas;

const datosPorTemporada = {};
listaTemporadas.forEach((t) => {
  datosPorTemporada[t] = computarDatos(
    stats.filter((s) => s.partidos?.equipos?.temporadas?.nombre === t),
  );
});
if (opcionesTemporada.includes("total")) {
  datosPorTemporada["total"] = computarDatos(stats);
}

const temporadaPorDefecto = listaTemporadas[0] ?? "total";

const iniciales =
  `${jugador.nombre?.[0] ?? ""}${jugador.apellido?.[0] ?? ""}`.toUpperCase();

const equipoActual = historialOrdenado[0]?.equipos;
const dorsalActual = historialOrdenado[0]?.dorsal;
const datosActuales =
  datosPorTemporada[temporadaPorDefecto] ?? computarDatos([]);

const genderoCategoriaLabel = {
  masculino: "Masculino",
  femenino: "Femenino",
  mixto: "Mixto",
};
---

<Layout titulo={`${jugador.nombre} ${jugador.apellido} | CB Jaca`}>
  <!-- Foto en segundo plano a la izquierda -->
  {
    jugador.foto_accion_url && (
      <div class="bg-foto-wrapper" aria-hidden="true">
        <img src={jugador.foto_accion_url} alt="" class="bg-foto-img" />
      </div>
    )
  }

  <!-- Hero -->
  <div class="jugador-hero">
    {
      dorsalActual != null && (
        <span class="dorsal-gigante" aria-hidden="true">
          #{dorsalActual}
        </span>
      )
    }
    <div class="jugador-hero-inner">
      <a href="javascript:history.back()" class="volver">← Volver</a>

      <div class="jugador-hero-content">
        <div class="avatar-wrap">
          {
            jugador.foto_dni_url ? (
              <img
                src={jugador.foto_dni_url}
                alt={`${jugador.nombre} ${jugador.apellido}`}
                class="avatar avatar-foto"
              />
            ) : (
              <div class="avatar">{iniciales}</div>
            )
          }
          {
            dorsalActual != null && (
              <span class="dorsal-chip">#{dorsalActual}</span>
            )
          }
        </div>

        <div class="jugador-info">
          <div class="chips-row">
            <span class="chip chip-posicion">
              {
                posicionLabel[jugador.posicion] ??
                  jugador.posicion ??
                  "Sin posición"
              }
            </span>
            {
              equipoActual && (
                <span class="chip chip-categoria">
                  {equipoActual.categorias?.nombre ?? "—"}
                  {nombreCompeticion(equipoActual) &&
                    ` · ${nombreCompeticion(equipoActual)}`}
                </span>
              )
            }
          </div>
          <h1>
            {jugador.nombre}
            <span class="apellido">{jugador.apellido}</span>
          </h1>

          <div class="hero-stats">
            <div class="hero-stat">
              <span class="hero-stat-val">{datosActuales.mediasFmt.puntos}</span
              >
              <span class="hero-stat-label">PTS/P</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-val"
                >{datosActuales.mediasFmt.rebotes}</span
              >
              <span class="hero-stat-label">REB/P</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-val"
                >{datosActuales.mediasFmt.asistencias}</span
              >
              <span class="hero-stat-label">AST/P</span>
            </div>
            <div class="hero-stat">
              <span class="hero-stat-val"
                >{datosActuales.mediasFmt.valoracion}</span
              >
              <span class="hero-stat-label">VAL/P</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="layout-jugador">
    <!-- ═══ SIDEBAR ═══ -->
    <aside class="sidebar">
      <div class="card-ficha">
        <h2 class="ficha-titulo">Ficha técnica</h2>
        <dl class="ficha-lista">
          <div class="ficha-fila">
            <dt>Posición</dt>
            <dd>
              {posicionLabel[jugador.posicion] ?? jugador.posicion ?? "—"}
            </dd>
          </div>
          {
            equipoActual?.categorias?.genero && (
              <div class="ficha-fila">
                <dt>Categoría</dt>
                <dd>
                  {genderoCategoriaLabel[equipoActual.categorias.genero] ??
                    equipoActual.categorias.genero}
                </dd>
              </div>
            )
          }
          <div class="ficha-fila">
            <dt>Temporadas en CB Jaca</dt>
            <dd>{listaTemporadas.length || "—"}</dd>
          </div>
          {
            dorsalActual != null && (
              <div class="ficha-fila">
                <dt>Dorsal actual</dt>
                <dd>#{dorsalActual}</dd>
              </div>
            )
          }
        </dl>
      </div>
    </aside>

    <!-- ═══ CONTENIDO PRINCIPAL ═══ -->
    <div class="contenido">
      {
        opcionesTemporada.length > 1 && (
          <div class="selector-wrap">
            <label for="selector-temporada" class="selector-label">
              Temporada
            </label>
            <select id="selector-temporada">
              {opcionesTemporada.map((t) => (
                <option value={t} selected={t === temporadaPorDefecto}>
                  {t === "total" ? "Carrera total" : t}
                </option>
              ))}
            </select>
          </div>
        )
      }

      {
        opcionesTemporada.map((t) => {
          const d = datosPorTemporada[t];
          const pctTc = porcentaje(d.totales.tc_an, d.totales.tc_int);
          const pct3 = porcentaje(d.totales.t3_an, d.totales.t3_int);
          const pctTl = porcentaje(d.totales.tl_an, d.totales.tl_int);
          const cx = 110,
            cy = 110,
            radio = 88;
          const ejes = ["PTS", "REB", "AST", "DEF", "VAL"];

          return (
            <div
              class="bloque-temporada"
              data-temporada={t}
              class:list={[{ activo: t === temporadaPorDefecto }]}
            >
              {/* Highlights sin minutos */}
              {d.jugados > 0 && (
                <section class="seccion">
                  <h2 class="seccion-titulo">Highlights de temporada</h2>
                  <div class="highlights-grid">
                    {d.maxPuntos && (d.maxPuntos.puntos ?? 0) > 0 && (
                      <div class="highlight-card">
                        <span class="highlight-icono">🏀</span>
                        <div>
                          <div class="highlight-valor">
                            {d.maxPuntos.puntos} pts
                          </div>
                          <div class="highlight-detalle">
                            vs {nombreRival(d.maxPuntos.partidos)} ·{" "}
                            {formatFecha(d.maxPuntos.partidos?.fecha)}
                          </div>
                          <div class="highlight-label">Máxima anotación</div>
                        </div>
                      </div>
                    )}
                    {d.mejorTriples && (
                      <div class="highlight-card">
                        <span class="highlight-icono">🎯</span>
                        <div>
                          <div class="highlight-valor">
                            {d.mejorTriples.triples_anotados}/
                            {d.mejorTriples.triples_intentados} (
                            {porcentaje(
                              d.mejorTriples.triples_anotados,
                              d.mejorTriples.triples_intentados,
                            )}
                            %)
                          </div>
                          <div class="highlight-detalle">
                            vs {nombreRival(d.mejorTriples.partidos)} ·{" "}
                            {formatFecha(d.mejorTriples.partidos?.fecha)}
                          </div>
                          <div class="highlight-label">
                            Mejor partido en triples
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </section>
              )}

              {/* Porcentajes + Radar */}
              {d.jugados > 0 && (
                <section class="seccion seccion-alt">
                  <h2 class="seccion-titulo">Desglose estadístico</h2>
                  <div class="desglose-grid">
                    <div class="tiros-grid">
                      {[
                        {
                          label: "Tiro de campo",
                          an: d.totales.tc_an,
                          int: d.totales.tc_int,
                          pct: pctTc,
                        },
                        {
                          label: "Triples",
                          an: d.totales.t3_an,
                          int: d.totales.t3_int,
                          pct: pct3,
                        },
                        {
                          label: "Tiros libres",
                          an: d.totales.tl_an,
                          int: d.totales.tl_int,
                          pct: pctTl,
                        },
                      ].map(({ label, an, int: intt, pct }) => (
                        <div class="tiro-card">
                          <div class="tiro-top">
                            <span class={`tiro-pct nivel-${nivelPct(pct)}`}>
                              {intt ? `${pct}%` : "—"}
                            </span>
                            <span class="tiro-detalle">
                              {an}-{intt}
                            </span>
                          </div>
                          <div class="tiro-bar-track">
                            <div
                              class={`tiro-bar-fill nivel-${nivelPct(pct)}`}
                              style={`width:${pct}%`}
                            />
                          </div>
                          <div class="tiro-label">{label}</div>
                        </div>
                      ))}
                    </div>

                    <div class="radar-wrap">
                      <svg viewBox="0 0 220 220" class="radar-svg">
                        {[0.25, 0.5, 0.75, 1].map((nivel) => (
                          <polygon
                            points={poligonoRadar(
                              [nivel, nivel, nivel, nivel, nivel],
                              cx,
                              cy,
                              radio,
                            )}
                            class="radar-grid"
                          />
                        ))}
                        {ejes.map((_, i) => {
                          const p = etiquetaEje(i, ejes.length, cx, cy, radio);
                          return (
                            <line
                              x1={cx}
                              y1={cy}
                              x2={p.x}
                              y2={p.y}
                              class="radar-eje"
                            />
                          );
                        })}
                        <polygon
                          points={poligonoRadar(d.radar, cx, cy, radio)}
                          class="radar-area"
                        />
                        {ejes.map((label, i) => {
                          const p = etiquetaEje(
                            i,
                            ejes.length,
                            cx,
                            cy,
                            radio + 18,
                          );
                          return (
                            <text
                              x={p.x}
                              y={p.y}
                              class="radar-label"
                              text-anchor="middle"
                              dominant-baseline="middle"
                            >
                              {label}
                            </text>
                          );
                        })}
                      </svg>
                    </div>
                  </div>
                </section>
              )}

              {/* Log de partidos */}
              <section class="seccion">
                <div class="log-header">
                  <h2 class="seccion-titulo" style="margin-bottom:0">
                    Partidos {t !== "total" && `· ${t}`}
                  </h2>
                  {d.partidos.length > 0 && (
                    <button class="toggle-tabla" type="button">
                      Ver compacto
                    </button>
                  )}
                </div>

                {d.partidos.length === 0 ? (
                  <p class="vacio">
                    Sin partidos registrados en esta temporada.
                  </p>
                ) : (
                  <div class="log-tabla-wrap">
                    <table class="log-tabla">
                      <thead>
                        <tr>
                          <th>Fecha</th>
                          <th>Rival</th>
                          <th class="col-extra">Equipo</th>
                          <th>MIN</th>
                          <th>PTS</th>
                          <th>REB</th>
                          <th>AST</th>
                          <th class="col-extra">FG</th>
                          <th class="col-extra">3PT</th>
                          <th class="col-extra">FT</th>
                          <th class="col-extra">ROB</th>
                          <th class="col-extra">TAP</th>
                          <th>VAL</th>
                        </tr>
                      </thead>
                      <tbody>
                        {d.partidos.map((s) => {
                          const p = s.partidos;
                          const reb =
                            s.rebotes_totales ??
                            (parseInt(s.rebotes_ofensivos) || 0) +
                              (parseInt(s.rebotes_defensivos) || 0);
                          const eq = p?.equipos;
                          const nombreEq =
                            eq?.sponsors?.nombre ??
                            eq?.categorias?.nombre ??
                            "—";
                          const gano =
                            (p?.puntos_favor ?? 0) > (p?.puntos_contra ?? 0);
                          const esMejorPartido =
                            p?.id && p.id === d.idMejorPartido;
                          return (
                            <tr
                              class:list={[
                                { "fila-destacada": esMejorPartido },
                              ]}
                            >
                              <td class="fecha-col">{formatFecha(p?.fecha)}</td>
                              <td class="rival-col">
                                <span class="condicion">
                                  {p?.es_local ? "vs" : "@"}
                                </span>
                                {nombreRival(p)}
                                {p?.puntos_favor != null && (
                                  <span
                                    class={`resultado-chip ${gano ? "win" : "loss"}`}
                                  >
                                    {gano ? "V" : "D"} {p.puntos_favor}-
                                    {p.puntos_contra}
                                  </span>
                                )}
                              </td>
                              <td class="equipo-col col-extra">{nombreEq}</td>
                              <td class="min-col">
                                {minutosDisplay(s.minutos)}
                              </td>
                              <td class="destacado">{s.puntos ?? 0}</td>
                              <td>{reb}</td>
                              <td>{s.asistencias ?? 0}</td>
                              <td class="tiro col-extra">
                                {s.tiros_campo_anotados ?? 0}-
                                {s.tiros_campo_intentados ?? 0}
                              </td>
                              <td class="tiro col-extra">
                                {s.triples_anotados ?? 0}-
                                {s.triples_intentados ?? 0}
                              </td>
                              <td class="tiro col-extra">
                                {s.tiros_libres_anotados ?? 0}-
                                {s.tiros_libres_intentados ?? 0}
                              </td>
                              <td class="col-extra">{s.robos ?? 0}</td>
                              <td class="col-extra">{s.tapones ?? 0}</td>
                              <td class="destacado">{s.valoracion ?? 0}</td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                )}
              </section>
            </div>
          );
        })
      }

      <!-- Historial de equipos: timeline -->
      <section class="seccion">
        <h2 class="seccion-titulo">Trayectoria</h2>
        {
          historialOrdenado.length === 0 ? (
            <p class="vacio">Sin temporadas registradas.</p>
          ) : (
            <div class="timeline">
              {historialOrdenado.map((h) => {
                const eq = h.equipos;
                const nombreEquipo = nombreEquipoPropio(eq);
                const href =
                  eq?.categorias?.slug && eq?.temporadas?.nombre
                    ? `/equipos/${eq.categorias.slug}/${eq.temporadas.nombre}`
                    : null;
                return (
                  <div class="timeline-item">
                    <div class="timeline-punto" />
                    <div class="timeline-card">
                      <div class="timeline-dorsal">#{h.dorsal ?? "—"}</div>
                      <div class="timeline-info">
                        <span class="timeline-temporada">
                          {eq?.temporadas?.nombre ?? "—"}
                        </span>
                        <span class="timeline-equipo">
                          {href ? (
                            <a href={href}>{nombreEquipo}</a>
                          ) : (
                            nombreEquipo
                          )}
                        </span>
                        <span class="timeline-meta">
                          {nombreCompeticion(eq)}
                        </span>
                      </div>
                      {href && (
                        <a
                          href={href}
                          class="timeline-arrow"
                          aria-hidden="true"
                        >
                          →
                        </a>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )
        }
      </section>
    </div>
  </div>
</Layout>

<script>
  const selector = document.getElementById("selector-temporada");
  selector?.addEventListener("change", (e) => {
    const val = (e.target as HTMLSelectElement).value;
    document
      .querySelectorAll<HTMLElement>(".bloque-temporada")
      .forEach((el) => {
        el.classList.toggle("activo", el.dataset.temporada === val);
      });
  });

  document
    .querySelectorAll<HTMLButtonElement>(".toggle-tabla")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const seccion = btn.closest(".seccion");
        const wrap = seccion?.querySelector(".log-tabla-wrap");
        if (!wrap) return;
        const compacto = wrap.classList.toggle("compacto");
        btn.textContent = compacto ? "Ver completo" : "Ver compacto";
      });
    });
</script>

