---
// src/pages/jugadores/[id].astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";
import { computarDatos } from "@/lib/jugador-stats.js";
import "@/styles/jugador.css";

import JugadorHero from "@/components/jugador/JugadorHero.astro";
import FichaTecnica from "@/components/jugador/FichaTecnica.astro";
import SelectorTemporada from "@/components/jugador/SelectorTemporada.astro";
import HighlightsTemporada from "@/components/jugador/HighlightsTemporada.astro";
import DesgloseEstadistico from "@/components/jugador/DesgloseEstadistico.astro";
import LogPartidos from "@/components/jugador/LogPartidos.astro";
import TrayectoriaTimeline from "@/components/jugador/TrayectoriaTimeline.astro";

export async function getStaticPaths() {
  const { data: jugadores } = await supabase.from("jugadores").select("id");

  return (jugadores ?? []).map((j) => ({
    params: { id: j.id },
  }));
}

const { id } = Astro.params;

// ── Datos del jugador ──────────────────────────────────────────────────────
const { data: jugador } = await supabase
  .from("jugadores")
  .select(
    "id, nombre, apellido, posicion, genero, foto_dni_url, foto_accion_url",
  )
  .eq("id", id)
  .single();

if (!jugador) return Astro.redirect("/equipos");

// ── Historial de equipos por temporada ────────────────────────────────────
const { data: historial, error: errorHistorial } = await supabase
  .from("convocatorias_temporada")
  .select(
    `
    dorsal,
    equipos (
      id,
      sponsors ( nombre ),
      categorias ( nombre, slug, genero ),
      temporadas ( id, nombre ),
      equipo_competiciones (
        competiciones ( nombre )
      )
    )
  `,
  )
  .eq("jugador_id", id)
  .order("equipo_id");

if (errorHistorial) console.error("Error historial:", errorHistorial);

// Ordenar historial por temporada más reciente
const historialOrdenado = (historial ?? []).sort((a, b) =>
  (b.equipos?.temporadas?.nombre ?? "").localeCompare(
    a.equipos?.temporadas?.nombre ?? "",
  ),
);

// ── Estadísticas por partido ───────────────────────────────────────────────
const { data: statsPartidos, error: errorStats } = await supabase
  .from("convocatorias_partido")
  .select(
    `
    titular, minutos, puntos, valoracion,
    tiros_campo_intentados, tiros_campo_anotados,
    triples_intentados, triples_anotados,
    tiros_libres_intentados, tiros_libres_anotados,
    rebotes_ofensivos, rebotes_defensivos, rebotes_totales,
    asistencias, robos, tapones, perdidas, faltas_cometidas,
    partidos (
      id, fecha, jornada, ronda, es_local,
      puntos_favor, puntos_contra,
      equipos (
        sponsors ( nombre ),
        categorias ( nombre, slug ),
        temporadas ( nombre )
      ),
      participante_local:participantes!participante_local_id (
        nombre_equipo,
        equipos_rivales ( nombre_equipo )
      ),
      participante_visitante:participantes!participante_visitante_id (
        nombre_equipo,
        equipos_rivales ( nombre_equipo )
      )
    )
  `,
  )
  .eq("jugador_id", id)
  .order("partidos(fecha)", { ascending: false });

if (errorStats) console.error("Error stats:", errorStats);

const stats = statsPartidos ?? [];

// ── Agrupación por temporada ────────────────────────────────────────────────
const temporadasSet = new Set();
stats.forEach((s) => {
  const t = s.partidos?.equipos?.temporadas?.nombre;
  if (t) temporadasSet.add(t);
});
const listaTemporadas = [...temporadasSet].sort().reverse();

// Temporadas reales en el club (aunque no haya jugado minutos en ninguna,
// viene de convocatorias_temporada, no de las estadísticas de partido)
const temporadasClub = new Set(
  historialOrdenado.map((h) => h.equipos?.temporadas?.nombre).filter(Boolean),
);

const opcionesTemporada =
  listaTemporadas.length > 1 ? [...listaTemporadas, "total"] : listaTemporadas;

const datosPorTemporada = {};
listaTemporadas.forEach((t) => {
  datosPorTemporada[t] = computarDatos(
    stats.filter((s) => s.partidos?.equipos?.temporadas?.nombre === t),
  );
});
if (opcionesTemporada.includes("total")) {
  datosPorTemporada["total"] = computarDatos(stats);
}

const temporadaPorDefecto = listaTemporadas[0] ?? "total";

const equipoActual = historialOrdenado[0]?.equipos;
const dorsalActual = historialOrdenado[0]?.dorsal;
const datosActuales =
  datosPorTemporada[temporadaPorDefecto] ?? computarDatos([]);
---

<Layout titulo={`${jugador.nombre} ${jugador.apellido} | CB Jaca`}>
  <JugadorHero
    jugador={jugador}
    dorsalActual={dorsalActual}
    equipoActual={equipoActual}
    datosActuales={datosActuales}
  />

  <div class="layout-jugador">
    <aside class="sidebar">
      <FichaTecnica
        jugador={jugador}
        equipoActual={equipoActual}
        temporadasClub={temporadasClub.size}
      />
    </aside>

    <div class="contenido">
      {
        opcionesTemporada.length > 1 && (
          <SelectorTemporada
            opciones={opcionesTemporada}
            porDefecto={temporadaPorDefecto}
          />
        )
      }

      {
        opcionesTemporada.map((t) => {
          const d = datosPorTemporada[t];
          return (
            <div
              class="bloque-temporada"
              data-temporada={t}
              class:list={[{ activo: t === temporadaPorDefecto }]}
            >
              {d.jugados > 0 && <HighlightsTemporada datos={d} />}
              {d.jugados > 0 && <DesgloseEstadistico datos={d} />}
              <LogPartidos datos={d} temporada={t} />
            </div>
          );
        })
      }

      <TrayectoriaTimeline historial={historialOrdenado} />
    </div>
  </div>
</Layout>
