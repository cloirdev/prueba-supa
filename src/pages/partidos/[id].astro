---
// src/pages/partidos/[id].astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const { data: partidos } = await supabase.from("partidos").select("id");
  return (partidos ?? []).map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;

const { data: partido } = await supabase
  .from("partidos")
  .select(`
    id, es_local, fecha, jornada, ronda,
    puntos_favor, puntos_contra,
    equipos (
      id, sponsor,
      categorias (nombre, slug),
      temporadas (nombre),
      competiciones (nombre)
    ),
    participante_local:participantes!participante_local_id (
      id, nombre_equipo, clubes(nombre, logo_url)
    ),
    participante_visitante:participantes!participante_visitante_id (
      id, nombre_equipo, clubes(nombre, logo_url)
    )
  `)
  .eq("id", id)
  .single();

if (!partido) return Astro.redirect("/");

const { data: cronica } = await supabase
  .from("cronicas")
  .select("contenido, publicada")
  .eq("partido_id", id)
  .eq("publicada", true)
  .single();

const { data: fotos } = await supabase
  .from("fotos")
  .select("id, url, descripcion")
  .eq("partido_id", id);

const { data: boxscore } = await supabase
  .from("convocatorias_partido")
  .select(`
    titular, minutos, puntos,
    tiros_2_anotados, tiros_2_intentados,
    tiros_campo_intentados, tiros_campo_anotados,
    triples_intentados, triples_anotados,
    tiros_libres_intentados, tiros_libres_anotados,
    rebotes_ofensivos, rebotes_defensivos, rebotes_totales,
    asistencias, robos, tapones, perdidas,
    faltas_cometidas, faltas_recibidas,
    mas_menos, valoracion,
    jugadores (id, nombre, apellido, posicion)
  `)
  .eq("partido_id", id)
  .order("titular", { ascending: false });

const equipoId = partido.equipos?.id;
const { data: dorsales } = await supabase
  .from("convocatorias_temporada")
  .select("jugador_id, dorsal")
  .eq("equipo_id", equipoId);

const dorsalMap = new Map((dorsales ?? []).map((d) => [d.jugador_id, d.dorsal]));

// Resolver nombre y escudo del rival desde participantes
const participanteRival = partido.es_local
  ? partido.participante_visitante
  : partido.participante_local;

const disputado = partido.puntos_favor !== null;
const nombrePropio = partido.equipos?.sponsor
  ? `${partido.equipos.sponsor} CB Jaca`
  : `CB Jaca ${partido.equipos?.categorias?.nombre ?? ""}`;
const nombreRival = participanteRival?.nombre_equipo ?? participanteRival?.clubes?.nombre ?? "Rival";
const logoRival = participanteRival?.clubes?.logo_url ?? null;
const escudoPropio = "/escudo-naranja.png";

const pNuestros = partido.es_local ? partido.puntos_favor : partido.puntos_contra;
const pEllos = partido.es_local ? partido.puntos_contra : partido.puntos_favor;
const victoria = disputado && pNuestros > pEllos;

const equipoLocal = partido.es_local ? nombrePropio : nombreRival;
const equipoVisit = partido.es_local ? nombreRival : nombrePropio;
const ptosLocal = partido.es_local ? partido.puntos_favor : partido.puntos_contra;
const ptosVisit = partido.es_local ? partido.puntos_contra : partido.puntos_favor;
const escudoLocal = partido.es_local ? escudoPropio : (logoRival ?? "/escudo.png");
const escudoVisit = partido.es_local ? (logoRival ?? "/escudo.png") : escudoPropio;

const tieneCronica = !!cronica?.contenido;
const tieneFotos = (fotos ?? []).length > 0;
const tieneBoxscore = (boxscore ?? []).length > 0;

const tabDefault = tieneCronica ? "cronica" : tieneBoxscore ? "boxscore" : tieneFotos ? "fotos" : "cronica";

function formatMinutos(min) {
  if (!min) return "00:00";
  const segs = parseInt(min);
  const mm = Math.floor(segs / 60);
  const ss = segs % 60;
  return `${String(mm).padStart(2, "0")}:${String(ss).padStart(2, "0")}`;
}

function formatFecha(f) {
  if (!f) return "Fecha por confirmar";
  return new Date(f).toLocaleDateString("es-ES", {
    weekday: "long", day: "numeric", month: "long", year: "numeric",
  });
}

function etiquetaJornada(p) {
  if (p.jornada) return `Jornada ${p.jornada}`;
  if (p.ronda && p.ronda !== "Amistoso") return p.ronda;
  return "Amistoso";
}

function sum(lista, campo) {
  return lista.reduce((a, s) => a + (parseInt(s[campo]) || 0), 0);
}

const titulares = (boxscore ?? []).filter((s) => s.titular);
const suplentes = (boxscore ?? []).filter((s) => !s.titular);

const categoriaSlug = partido.equipos?.categorias?.slug;
const temporadaSlug = partido.equipos?.temporadas?.nombre;
const equipoHref = categoriaSlug && temporadaSlug
  ? `/equipos/${categoriaSlug}/${temporadaSlug}`
  : null;
---

<Layout titulo={`${nombrePropio} vs ${nombreRival} | CB Jaca`}>
  <!-- ══ HERO ══ -->
  <div
    class="partido-hero"
    style={`--escudo-local: url('${escudoLocal}'); --escudo-visit: url('${escudoVisit}');`}
  >
    <div class="hero-escudo-local"></div>
    <div class="hero-escudo-visit"></div>
    <div class="hero-overlay"></div>

    <div class="hero-inner">
      <div class="hero-meta">
        <a href={equipoHref ?? "/equipos"} class="volver">← {nombrePropio}</a>
        <span class="hero-pill">{etiquetaJornada(partido)}</span>
        {partido.equipos?.competiciones?.nombre && (
          <span class="hero-pill muted">{partido.equipos.competiciones.nombre}</span>
        )}
      </div>

      <div class="marcador-wrap">
        <div class="equipo-col">
          <div class="escudo-box">
            <img src={escudoLocal} alt={equipoLocal} class="escudo-img" onerror="this.src='/escudo.png'" />
          </div>
          <span class="equipo-nombre">{equipoLocal}</span>
        </div>

        <div class="resultado-col">
          {disputado ? (
            <div class="marcador-numeros">
              <span class:list={["pts", ptosLocal >= ptosVisit ? "ganador" : "perdedor"]}>{ptosLocal}</span>
              <span class="separador">–</span>
              <span class:list={["pts", ptosVisit >= ptosLocal ? "ganador" : "perdedor"]}>{ptosVisit}</span>
            </div>
          ) : (
            <div class="pendiente-box">
              <span class="pendiente-label">Pendiente</span>
              <span class="pendiente-fecha">{formatFecha(partido.fecha)}</span>
            </div>
          )}
          {disputado && <span class="hero-fecha">{formatFecha(partido.fecha)}</span>}
        </div>

        <div class="equipo-col visitante">
          <div class="escudo-box">
            <img src={escudoVisit} alt={equipoVisit} class="escudo-img" onerror="this.src='/escudo.png'" />
          </div>
          <span class="equipo-nombre">{equipoVisit}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ══ PESTAÑAS ══ -->
  {(tieneCronica || tieneBoxscore || tieneFotos) && (
    <div class="tabs-outer">
      <div class="tabs-nav" role="tablist">
        {tieneCronica && (
          <button class="tab-btn" data-tab="cronica" role="tab">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4z"/><path d="M8 9h8M8 13h5"/></svg>
            Crónica
          </button>
        )}
        {tieneBoxscore && (
          <button class="tab-btn" data-tab="boxscore" role="tab">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
            Boxscore
          </button>
        )}
        {tieneFotos && (
          <button class="tab-btn" data-tab="fotos" role="tab">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            Fotos {tieneFotos && <span class="tab-count">{fotos.length}</span>}
          </button>
        )}
      </div>

      <!-- ── Crónica ── -->
      {tieneCronica && (
        <div class="tab-panel" data-panel="cronica">
          <div class="contenido-inner">
            <div class="cronica-texto">
              {cronica.contenido.split("\n").filter(Boolean).map((p) => <p>{p}</p>)}
            </div>
          </div>
        </div>
      )}

      <!-- ── Boxscore ── -->
      {tieneBoxscore && (
        <div class="tab-panel" data-panel="boxscore">
          <div class="contenido-inner contenido-wide">
            {[{ label: "Titulares", lista: titulares }, { label: "Suplentes", lista: suplentes }].map(
              ({ label, lista }) =>
                lista.length > 0 && (
                  <div class="boxscore-bloque">
                    <h3 class="boxscore-label">{label}</h3>
                    <div class="boxscore-wrap">
                      <table class="boxscore-tabla">
                        <thead>
                          <tr>
                            <th class="left">#</th>
                            <th class="left">Jugador</th>
                            <th>MIN</th>
                            <th>PTS</th>
                            <th>FG</th>
                            <th>T2</th>
                            <th>3PT</th>
                            <th>TL</th>
                            <th>OREB</th>
                            <th>DREB</th>
                            <th>REB</th>
                            <th>AST</th>
                            <th>ROB</th>
                            <th>PER</th>
                            <th>TAP</th>
                            <th>FC</th>
                            <th>FR</th>
                            <th>VAL</th>
                            <th>+/-</th>
                          </tr>
                        </thead>
                        <tbody>
                          {lista.map((s) => {
                            const j = s.jugadores;
                            const reb = (parseInt(s.rebotes_ofensivos) || 0) + (parseInt(s.rebotes_defensivos) || 0);
                            const dorsal = dorsalMap.get(j?.id) ?? "—";
                            const val = s.valoracion ?? 0;
                            const mm = s.mas_menos ?? 0;
                            return (
                              <tr>
                                <td class="dorsal-col">{dorsal}</td>
                                <td class="jugador-col">
                                  <a href={`/jugadores/${j?.id}`} class="jugador-link">
                                    {j?.nombre?.[0]}. {j?.apellido}
                                  </a>
                                </td>
                                <td style="font-family:monospace">{formatMinutos(s.minutos)}</td>
                                <td class="pts-col">{s.puntos ?? 0}</td>
                                <td class="tiro">{s.tiros_campo_anotados ?? 0}/{s.tiros_campo_intentados ?? 0}</td>
                                <td class="tiro">{s.tiros_2_anotados ?? 0}/{s.tiros_2_intentados ?? 0}</td>
                                <td class="tiro">{s.triples_anotados ?? 0}/{s.triples_intentados ?? 0}</td>
                                <td class="tiro">{s.tiros_libres_anotados ?? 0}/{s.tiros_libres_intentados ?? 0}</td>
                                <td>{s.rebotes_ofensivos ?? 0}</td>
                                <td>{s.rebotes_defensivos ?? 0}</td>
                                <td class="reb-col">{reb}</td>
                                <td>{s.asistencias ?? 0}</td>
                                <td>{s.robos ?? 0}</td>
                                <td>{s.perdidas ?? 0}</td>
                                <td>{s.tapones ?? 0}</td>
                                <td>{s.faltas_cometidas ?? 0}</td>
                                <td>{s.faltas_recibidas ?? 0}</td>
                                <td class:list={["val-col", val > 0 ? "pos" : val < 0 ? "neg" : ""]}>
                                  {val > 0 ? `+${val}` : val}
                                </td>
                                <td class:list={["mm-col", mm > 0 ? "pos" : mm < 0 ? "neg" : ""]}>
                                  {mm > 0 ? `+${mm}` : mm}
                                </td>
                              </tr>
                            );
                          })}
                          <tr class="totales-row">
                            <td />
                            <td class="left" style="font-size:0.62rem;font-weight:700;letter-spacing:.06em;color:var(--muted)">TOTALES</td>
                            <td>—</td>
                            <td class="pts-col">{sum(lista, "puntos")}</td>
                            <td class="tiro">{sum(lista, "tiros_campo_anotados")}/{sum(lista, "tiros_campo_intentados")}</td>
                            <td class="tiro">{sum(lista, "tiros_2_anotados")}/{sum(lista, "tiros_2_intentados")}</td>
                            <td class="tiro">{sum(lista, "triples_anotados")}/{sum(lista, "triples_intentados")}</td>
                            <td class="tiro">{sum(lista, "tiros_libres_anotados")}/{sum(lista, "tiros_libres_intentados")}</td>
                            <td>{sum(lista, "rebotes_ofensivos")}</td>
                            <td>{sum(lista, "rebotes_defensivos")}</td>
                            <td class="reb-col">{sum(lista, "rebotes_ofensivos") + sum(lista, "rebotes_defensivos")}</td>
                            <td>{sum(lista, "asistencias")}</td>
                            <td>{sum(lista, "robos")}</td>
                            <td>{sum(lista, "perdidas")}</td>
                            <td>{sum(lista, "tapones")}</td>
                            <td>{sum(lista, "faltas_cometidas")}</td>
                            <td>{sum(lista, "faltas_recibidas")}</td>
                            <td class="val-col">
                              {sum(lista, "valoracion") > 0 ? `+${sum(lista, "valoracion")}` : sum(lista, "valoracion")}
                            </td>
                            <td>—</td>
                          </tr>
                        </tbody>
                      </table>
                    </div>
                  </div>
                )
            )}
          </div>
        </div>
      )}

      <!-- ── Fotos ── -->
      {tieneFotos && (
        <div class="tab-panel" data-panel="fotos">
          <div class="contenido-inner">
            <div class="fotos-grid">
              {fotos.map((f) => (
                <a href={f.url} target="_blank" rel="noopener" class="foto-wrap">
                  <img src={f.url} alt={f.descripcion ?? "Foto del partido"} class="foto-img" loading="lazy" />
                </a>
              ))}
            </div>
          </div>
        </div>
      )}
    </div>
  )}
</Layout>

<style>
  /* ══ HERO ══ */
  .partido-hero {
    position: relative;
    background-color: #0f172a;
    color: white;
    overflow: hidden;
    padding: 3rem 2rem 3.5rem;
    min-height: 280px;
    display: flex;
    align-items: center;
  }

  .hero-escudo-local,
  .hero-escudo-visit {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-size: 28%;
    z-index: 0;
    pointer-events: none;
  }
  .hero-escudo-local {
    background-image: var(--escudo-local);
    background-position: left -3rem center;
    opacity: 0.08;
    filter: grayscale(0.3);
  }
  .hero-escudo-visit {
    background-image: var(--escudo-visit);
    background-position: right -3rem center;
    opacity: 0.08;
    filter: grayscale(0.6);
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 100% at 50% 50%, rgba(15,23,42,0.5) 0%, rgba(15,23,42,0.9) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .volver {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--naranja, #f28241);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-right: auto;
  }
  .volver:hover { opacity: 0.8; }

  .hero-pill {
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 3px 10px;
    border-radius: 20px;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.1);
  }
  .hero-pill.muted { color: rgba(255,255,255,0.3); }
  .hero-pill.resultado.victoria { background: rgba(34,197,94,0.15); color: #4ade80; border-color: rgba(34,197,94,0.25); }
  .hero-pill.resultado.derrota  { background: rgba(59,130,246,0.15); color: #60a5fa; border-color: rgba(59,130,246,0.25); }

  .marcador-wrap {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }
  .equipo-col { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .equipo-col.visitante { align-items: flex-end; text-align: right; }
  .escudo-box {
    width: 64px; height: 64px;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; padding: 6px;
  }
  .escudo-img { width: 100%; height: 100%; object-fit: contain; }
  .equipo-nombre { font-size: clamp(0.85rem, 2.2vw, 1.15rem); font-weight: 800; line-height: 1.2; color: white; }

  .resultado-col { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .marcador-numeros { display: flex; align-items: center; gap: 0.5rem; }
  .pts { font-size: clamp(2.5rem, 7vw, 4rem); font-weight: 900; font-variant-numeric: tabular-nums; line-height: 1; }
  .pts.ganador { color: white; }
  .pts.perdedor { color: rgba(255,255,255,0.22); }
  .separador { font-size: 1.8rem; color: rgba(255,255,255,0.15); font-weight: 300; }
  .hero-fecha { font-size: 0.72rem; color: rgba(255,255,255,0.35); text-align: center; text-transform: capitalize; }
  .pendiente-box { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .pendiente-label { font-size: 0.8rem; font-weight: 700; color: rgba(255,255,255,0.25); text-transform: uppercase; letter-spacing: 0.08em; }
  .pendiente-fecha { font-size: 0.82rem; color: rgba(255,255,255,0.5); text-align: center; }

  /* ══ PESTAÑAS ══ */
  .tabs-outer {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem 4rem;
  }

  .tabs-nav {
    display: flex;
    gap: 0;
    border-bottom: 2px solid var(--borde);
    margin-bottom: 2rem;
    margin-top: 2rem;
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    transition: color .15s, border-color .15s;
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .tab-btn:hover { color: var(--texto); }
  .tab-btn.active {
    color: var(--naranja, #f28241);
    border-bottom-color: var(--naranja, #f28241);
  }
  .tab-count {
    font-size: 0.65rem;
    background: var(--color-background-secondary);
    border: 1px solid var(--borde);
    border-radius: 10px;
    padding: 1px 6px;
    font-weight: 700;
    color: var(--muted);
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ══ CONTENIDO INTERIOR ══ */
  .contenido-inner {
    max-width: 720px;
  }
  .contenido-wide {
    max-width: 100%;
  }

  /* Crónica */
  .cronica-texto { font-size: 1rem; line-height: 1.85; }
  .cronica-texto p { margin-bottom: 1rem; }

  /* Fotos */
  .fotos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.6rem;
  }
  .foto-wrap { border-radius: 10px; overflow: hidden; border: 1px solid var(--borde); display: block; aspect-ratio: 4/3; }
  .foto-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .foto-wrap:hover .foto-img { transform: scale(1.04); }

  /* Boxscore */
  .boxscore-bloque { margin-bottom: 2rem; }
  .boxscore-label {
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--muted); margin-bottom: 0.6rem;
  }
  .boxscore-wrap { overflow-x: auto; }
  .boxscore-tabla { width: 100%; border-collapse: collapse; font-size: 0.82rem; min-width: 700px; }
  .boxscore-tabla thead tr { border-bottom: 2px solid var(--naranja, #f28241); }
  .boxscore-tabla th {
    padding: 0.4rem 0.6rem; text-align: center;
    font-size: 0.62rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--muted); white-space: nowrap;
  }
  .boxscore-tabla th.left { text-align: left; }
  .boxscore-tabla tbody tr { border-bottom: 1px solid var(--borde); transition: background 0.15s; }
  .boxscore-tabla tbody tr:hover { background: var(--card); }
  .boxscore-tabla td { padding: 0.5rem 0.6rem; text-align: center; color: var(--muted); }
  .boxscore-tabla td.left { text-align: left; }

  .dorsal-col { font-size: 0.72rem; font-weight: 700; color: var(--naranja, #f28241) !important; width: 28px; }
  .jugador-col { min-width: 130px; }
  .jugador-link { font-weight: 700; font-size: 0.85rem; color: var(--texto) !important; text-decoration: none; }
  .jugador-link:hover { color: var(--naranja, #f28241) !important; }
  .pts-col { font-weight: 800; font-size: 0.95rem; color: var(--naranja, #f28241) !important; }
  .tiro { font-size: 0.75rem; }
