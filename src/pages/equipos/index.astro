---
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

const { data: categorias, error } = await supabase
  .from("categorias")
  .select("id, nombre, slug, orden, genero")
  .order("orden", { ascending: true });

if (error) console.error("Error cargando categorías:", error);

const categoriasConEquipo = await Promise.all(
  (categorias ?? [])
    .filter((cat) => cat.slug)
    .map(async (cat) => {
      const { data: equipos } = await supabase
        .from("equipos")
        .select("id, sponsor, temporada_id, foto_url, temporadas (nombre)")
        .eq("categoria_id", cat.id);

      const equipo =
        equipos?.sort((a, b) =>
          (b.temporadas?.nombre ?? "").localeCompare(
            a.temporadas?.nombre ?? "",
          ),
        )[0] ?? null;
      const temporadaSlug = equipo?.temporadas?.nombre ?? null;

      return { ...cat, equipo, temporadaSlug };
    }),
);

const iconoGenero = { masculino: "♂", femenino: "♀", mixto: "⚥" };
---

<Layout titulo="Equipos - CB Jaca">
  <section class="equipos-section">
    <div class="equipos-header">
      <h1>Nuestros <span class="highlight">Equipos</span></h1>
      <p class="subtitulo">
        Selecciona una categoría para ver su plantilla y calendario.
      </p>
    </div>

    <div class="equipos-grid">
      {
        categoriasConEquipo.map((cat) => {
          const href = cat.temporadaSlug
            ? `/equipos/${cat.slug}/${cat.temporadaSlug}`
            : null;
          const nombreEquipo = cat.equipo?.sponsor
            ? `${cat.equipo.sponsor} CB Jaca`
            : `CB Jaca ${cat.nombre}`;
          const foto = cat.equipo?.foto_url;

          return href ? (
            <a
              href={href}
              class="equipo-card"
              style={foto ? `--bg-img: url('${foto}')` : ""}
              data-tiene-foto={foto ? "true" : "false"}
            >
              <div class="card-inner">
                <div class="card-top">
                  <span class="genero-badge">
                    {iconoGenero[cat.genero] ?? ""} {cat.nombre}
                  </span>
                  {cat.equipo?.temporadas?.nombre && (
                    <span class="temporada-badge">
                      {cat.equipo.temporadas.nombre}
                    </span>
                  )}
                </div>
                <div class="card-bottom">
                  <div class="card-logos">
                    <img
                      src="/escudo-naranja.png"
                      alt="CB Jaca"
                      class="escudo-card"
                    />
                  </div>
                  <div>
                    <h2 class="card-nombre">{nombreEquipo}</h2>
                    <span class="ver-mas">Ver equipo →</span>
                  </div>
                </div>
              </div>
            </a>
          ) : (
            <div class="equipo-card equipo-card--inactivo">
              <div class="card-inner">
                <div class="card-top">
                  <span class="genero-badge">
                    {iconoGenero[cat.genero] ?? ""} {cat.nombre}
                  </span>
                </div>
                <div class="card-bottom">
                  <h2 class="card-nombre">{cat.nombre}</h2>
                  <p class="sin-datos">Sin temporada activa</p>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>

    {
      (!categorias || categorias.length === 0) && (
        <p class="vacio">No se han encontrado categorías.</p>
      )
    }
  </section>
</Layout>

<style>
  .equipos-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .equipos-header {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }
  .highlight {
    color: var(--naranja, #f97316);
  }
  .subtitulo {
    font-size: 1rem;
    color: var(--muted, #64748b);
  }

  .equipos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
    gap: 1.5rem;
  }

  /* ── Card ── */
  .equipo-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: clamp(220px, 28vw, 340px);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: white;
    border: 1px solid var(--borde, rgba(255, 255, 255, 0.08));
    background-color: #0f172a;
    transition: border-color 0.2s;
  }
  .equipo-card:hover {
    border-color: var(--naranja, #f97316);
  }

  /* Fondo con foto */
  .equipo-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.55) 0%,
        rgba(0, 0, 0, 0.1) 40%,
        rgba(0, 0, 0, 0.75) 100%
      ),
      var(--bg-img, none);
    background-position: center;
    background-size: cover;
    transform: scale(1.02);
    transition:
      transform 0.6s ease,
      filter 0.6s ease;
    filter: grayscale(0.6);
  }
  .equipo-card:hover::before {
    transform: scale(1.07);
    filter: grayscale(0);
  }

  /* Sin foto: fondo sólido con acento naranja */
  .equipo-card[data-tiene-foto="false"]::before {
    background-image: linear-gradient(
      135deg,
      #0f172a 60%,
      rgba(242, 130, 65, 0.15) 100%
    );
  }

  .card-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding: 1.25rem 1.5rem;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .genero-badge {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--naranja, #f97316);
    background: rgba(0, 0, 0, 0.4);
    padding: 3px 10px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
  }
  .temporada-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.4);
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
  }

  .card-bottom {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
  }
  .escudo-card {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }
  .card-nombre {
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 800;
    margin: 0 0 0.3rem;
    line-height: 1.2;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  }
  .ver-mas {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--naranja, #f97316);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .equipo-card--inactivo {
    opacity: 0.45;
    cursor: default;
  }
  .sin-datos {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  .vacio {
    text-align: center;
    color: var(--muted, #64748b);
    padding: 3rem;
  }

  @media (max-width: 640px) {
    .equipos-section {
      padding: 2rem 1rem;
    }
    .equipos-grid {
      grid-template-columns: 1fr;
    }
    .equipo-card {
      height: 200px;
    }
  }
</style>
