---
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

// Traemos categorías con su slug y el equipo más reciente de cada una
const { data: categorias, error } = await supabase
  .from("categorias")
  .select("id, nombre, slug, orden, genero")
  .order("orden", { ascending: true });

if (error) console.error("Error cargando categorías:", error);

// Para cada categoría, buscamos el equipo de la temporada más reciente
const categoriasConEquipo = await Promise.all(
  (categorias ?? [])
    .filter((cat) => cat.slug)
    .map(async (cat) => {
      const { data: equipos } = await supabase
        .from("equipos")
        .select("id, sponsor, temporada_id, temporadas (nombre)")
        .eq("categoria_id", cat.id);

      const equipo =
        equipos?.sort((a, b) =>
          (b.temporadas?.nombre ?? "").localeCompare(
            a.temporadas?.nombre ?? "",
          ),
        )[0] ?? null;
      const temporadaSlug = equipo?.temporadas?.nombre ?? null;

      return { ...cat, equipo, temporadaSlug };
    }),
);

const iconoGenero = {
  masculino: "♂",
  femenino: "♀",
  mixto: "⚥",
};
---

<Layout titulo="Equipos - CB Jaca">
  <section class="equipos-section">
    <div class="equipos-header">
      <h1>Nuestros <span class="highlight">Equipos</span></h1>
      <p class="subtitulo">
        Selecciona una categoría para ver su plantilla y calendario.
      </p>
    </div>

    <div class="equipos-grid">
      {
        categoriasConEquipo.map((cat) => {
          const href = cat.temporadaSlug
            ? `/equipos/${cat.slug}/${cat.temporadaSlug}`
            : null;
          const nombreEquipo = cat.equipo?.sponsor
            ? `${cat.equipo.sponsor} CB Jaca`
            : `CB Jaca ${cat.nombre}`;

          return href ? (
            <a href={href} class="equipo-card">
              <div class="card-top">
                <span class="genero-badge">
                  {iconoGenero[cat.genero] ?? ""} {cat.nombre}
                </span>
                {cat.equipo?.temporadas?.nombre && (
                  <span class="temporada-badge">
                    {cat.equipo.temporadas.nombre}
                  </span>
                )}
              </div>
              <h2 class="card-nombre">{nombreEquipo}</h2>
              <div class="card-footer">
                <span class="ver-mas">Ver equipo →</span>
              </div>
            </a>
          ) : (
            <div class="equipo-card equipo-card--inactivo">
              <div class="card-top">
                <span class="genero-badge">
                  {iconoGenero[cat.genero] ?? ""} {cat.nombre}
                </span>
              </div>
              <h2 class="card-nombre">{cat.nombre}</h2>
              <p class="sin-datos">Sin temporada activa</p>
            </div>
          );
        })
      }
    </div>

    {
      (!categorias || categorias.length === 0) && (
        <p class="vacio">No se han encontrado categorías.</p>
      )
    }
  </section>
</Layout>

<style>
  .equipos-section {
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .equipos-header {
    margin-bottom: 3rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .highlight {
    color: var(--orange, #f97316);
  }

  .subtitulo {
    font-size: 1rem;
    color: var(--muted, #64748b);
  }

  .equipos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.75rem;
  }

  .equipo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--card, #1e293b);
    border: 1px solid var(--borde, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .equipo-card:hover {
    transform: translateY(-4px);
    border-color: var(--orange, #f97316);
  }

  .equipo-card--inactivo {
    opacity: 0.5;
    cursor: default;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .genero-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--orange, #f97316);
  }

  .temporada-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 20px;
    background: rgba(249, 115, 22, 0.12);
    color: var(--orange, #f97316);
    border: 1px solid rgba(249, 115, 22, 0.25);
  }

  .card-nombre {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.3;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid var(--borde, rgba(255, 255, 255, 0.08));
  }

  .ver-mas {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--muted, #64748b);
    transition: color 0.2s;
  }

  .equipo-card:hover .ver-mas {
    color: var(--orange, #f97316);
  }

  .sin-datos {
    font-size: 0.82rem;
    color: var(--muted, #64748b);
  }

  .vacio {
    text-align: center;
    color: var(--muted, #64748b);
    padding: 3rem;
  }

  @media (max-width: 640px) {
    .equipos-section {
      padding: 2rem 1rem;
    }
  }
</style>
