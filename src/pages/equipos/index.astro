---
// @ts-nocheck
import { supabase } from '@/lib/supabase.js'
import { slugify } from '@/utils/slugify.js'
import Layout from '@/layouts/Layout.astro'

// 1. Traemos todas las categorías, ordenadas si tienes el campo 'orden'
const { data: categorias, error } = await supabase
  .from('categorias')
  .select('*')
  .order('orden', { ascending: true }); // Si no tienes 'orden', usa 'nombre'

if (error) console.error("Error cargando categorías:", error);
---

<Layout titulo="Equipos - CB Jaca">
  <div style="margin-bottom: 40px;">
    <h1 style="font-size: 36px; font-weight: 800; color: black;">Nuestros <span style="color:var(--naranja)">Equipos</span></h1>
    <p class="muted">Selecciona una categoría para ver su historial y plantillas.</p>
  </div>

  <div class="grid-2">
    {categorias && categorias.map((cat) => (
      <a 
        href={`/equipos/${slugify(cat.nombre)}`} 
        class="card" 
        style="display: block; padding: 24px; text-decoration: none; transition: transform 0.2s;"
      >
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <h2 style="margin: 0; font-size: 20px; color: orange;">{cat.nombre}</h2>
          <span style="background: var(--azul-oscuro); color: var(--naranja); padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700;">
            Ver temporadas
          </span>
        </div>
        
        <p class="muted" style="margin-top: 12px; font-size: 14px;">
          Toda la información de los equipos {cat.nombre.toLowerCase()} del club.
        </p>
      </a>
    ))}
  </div>

  {(!categorias || categorias.length === 0) && (
    <div class="card" style="text-align: center; padding: 40px;">
      <p class="muted">No se han encontrado categorías en la base de datos.</p>
    </div>
  )}
</Layout>

<style>
  .grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--naranja);
  }
</style>