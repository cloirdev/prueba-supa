---
// src/pages/equipos/[categoria_slug]/index.astro
// @ts-nocheck
import { supabase } from "@/lib/supabase.js";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const { data: equipos } = await supabase.from("equipos").select(`
    id, created_at,
    categorias (nombre, slug),
    temporadas:temporadas!equipos_temporada_id_fkey (nombre)
  `);

  const slugMap = resolverSlugsEquipos(equipos ?? []);
  const vistos = new Map(); // slugFinal -> nombreCategoria

  (equipos ?? []).forEach((e) => {
    const slugFinal = slugMap.get(e.id);
    if (slugFinal && !vistos.has(slugFinal)) {
      vistos.set(slugFinal, e.categorias.nombre);
    }
  });

  return Array.from(vistos.entries()).map(([slug, nombre]) => ({
    params: { categoria_slug: slug },
    props: { nombreReal: nombre, categoriaSlug: slug },
  }));
}

const { categoria_slug } = Astro.params;
const { nombreReal, categoriaSlug } = Astro.props;

// Equipos de esta categoría con su temporada
const { data: equipos, error } = await supabase
  .from("equipos")
  .select(
    `
    id,
    sponsors:sponsors!equipos_sponsor_id_fkey (nombre),
    temporadas:temporadas!equipos_temporada_id_fkey (id, nombre),
    categorias!inner (nombre, slug)
  `,
  )
  .eq("categorias.slug", categoriaSlug);

if (error) console.error("Error en consulta:", error);

// Temporadas únicas ordenadas de más reciente a más antigua
const temporadasMap = new Map();
(equipos ?? []).forEach((e) => {
  if (e.temporadas) {
    temporadasMap.set(e.temporadas.id, {
      ...e.temporadas,
      slug: e.temporadas.nombre,
      sponsor: e.sponsors?.nombre,
    });
  }
});

const temporadasUnicas = Array.from(temporadasMap.values()).sort((a, b) =>
  b.nombre.localeCompare(a.nombre),
);

const esActiva = (idx) => idx === 0;
---

<Layout titulo={`${nombreReal} – Temporadas | CB Jaca`}>
  <section class="temporadas-section">
    <div class="temporadas-header">
      <a href="/equipos" class="volver">← Equipos</a>
      <h1>{nombreReal}</h1>
      <p class="subtitulo">Historial de equipos y plantillas por temporada.</p>
    </div>

    {
      temporadasUnicas.length === 0 ? (
        <div class="vacio">
          <p>
            Aún no hay equipos registrados para <strong>{nombreReal}</strong>.
          </p>
        </div>
      ) : (
        <div class="temporadas-lista">
          {temporadasUnicas.map((t, idx) => (
            <a
              href={`/equipos/${categoriaSlug}/${t.slug}`}
              class:list={["temporada-card", esActiva(idx) && "activa"]}
            >
              <div class="card-left">
                <span class="card-tag">
                  {esActiva(idx) ? "Temporada actual" : "Archivo"}
                </span>
                <span class="card-nombre">
                  {t.sponsor ? `${t.sponsor} CB Jaca` : `CB Jaca ${nombreReal}`}
                </span>
                <span class="card-temporada">Temporada {t.nombre}</span>
              </div>
              <span class="card-arrow">→</span>
            </a>
          ))}
        </div>
      )
    }
  </section>
</Layout>

<style>
  .temporadas-section {
    max-width: 700px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }

  .temporadas-header {
    margin-bottom: 2.5rem;
  }

  .volver {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--orange, #f97316);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    margin: 1rem 0 0.4rem;
  }

  .subtitulo {
    font-size: 0.95rem;
    color: var(--muted, #64748b);
  }

  .temporadas-lista {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .temporada-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--card, #1e293b);
    border: 1px solid var(--borde, rgba(255, 255, 255, 0.08));
    border-left: 3px solid transparent;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  .temporada-card:hover {
    border-color: var(--orange, #f97316);
    transform: translateX(4px);
  }

  .temporada-card.activa {
    border-left-color: var(--orange, #f97316);
  }

  .card-left {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .card-tag {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--orange, #f97316);
  }

  .card-nombre {
    font-size: 1rem;
    font-weight: 700;
  }

  .card-temporada {
    font-size: 0.8rem;
    color: var(--muted, #64748b);
  }

  .card-arrow {
    font-size: 1.2rem;
    font-weight: 900;
    color: var(--orange, #f97316);
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .temporada-card:hover .card-arrow {
    opacity: 1;
  }

  .vacio {
    padding: 3rem;
    text-align: center;
    background: var(--card, #1e293b);
    border: 1px dashed var(--borde, rgba(255, 255, 255, 0.15));
    border-radius: 10px;
    color: var(--muted, #64748b);
  }

  @media (max-width: 640px) {
    .temporadas-section {
      padding: 2rem 1rem;
    }
  }
</style>
