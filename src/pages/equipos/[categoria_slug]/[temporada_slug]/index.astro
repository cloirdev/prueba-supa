---
// src/pages/equipos/[categoria_slug]/[temporada_slug]/index.astro
// @ts-nocheck
import {
  getEquipoTemporadaPageData,
  getEquipoTemporadaStaticPaths,
} from "@/lib/services/equipos.js";
import Layout from "@/layouts/Layout.astro";
import { competicionesDe } from "@/lib/equipo-temporada.js";
import "@/styles/equipo.css";

import EquipoHero from "@/components/equipo/EquipoHero.astro";
import PlantillaPanel from "@/components/equipo/PlantillaPanel.astro";
import CalendarioPanel from "@/components/equipo/CalendarioPanel.astro";
import ClasificacionPanel from "@/components/equipo/ClasificacionPanel.astro";

export async function getStaticPaths() {
  return getEquipoTemporadaStaticPaths();
}

const {
  equipoIds,
  categoriaNombre,
  categoriaSlug,
  temporadaNombre,
  temporadaSlug,
} = Astro.props;

const {
  equipos,
  jugadoresPorEquipo,
  entrenadoresPorEquipo,
  partidosPorEquipo,
  fasesPorEquipo,
  participantesPorFase,
  clasificacionPorFase,
  temporadasOrdenadas,
} = await getEquipoTemporadaPageData(equipoIds, categoriaSlug);

// Nombre de transición único por equipo+temporada.
// DEBE coincidir exactamente con el generado en /equipos/index.astro:
// `equipo-${categoriaSlug}-${temporadaSlug}`
const nombreTransicion = `equipo-${categoriaSlug}-${temporadaSlug}`;
---

<Layout titulo={`${categoriaNombre} – ${temporadaNombre} | CB Jaca`}>
  <EquipoHero
    equipo={equipos?.[0]}
    categoriaNombre={categoriaNombre}
    categoriaSlug={categoriaSlug}
    temporadaSlug={temporadaSlug}
    temporadasOrdenadas={temporadasOrdenadas}
    nombreTransicion={nombreTransicion}
  />

  <div transition:animate="fade">
    {
      (equipos ?? []).map((equipo) => {
        const plantilla = jugadoresPorEquipo.get(equipo.id) ?? [];
        const todosPartidos = partidosPorEquipo.get(equipo.id) ?? [];
        const nombreEquipo = equipo.sponsors?.nombre
          ? `${equipo.sponsors.nombre} CB Jaca`
          : `CB Jaca ${categoriaNombre}`;
        const fasesEquipo = fasesPorEquipo.get(equipo.id) ?? [];
        const entrenadores = entrenadoresPorEquipo.get(equipo.id) ?? [];
        const competiciones = competicionesDe(equipo);

        const fasesPorCompeticion = competiciones
          .map((comp) => ({
            competicion: comp,
            fases: fasesEquipo
              .filter((f) => f.competicion_id === comp.id)
              .sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0)),
          }))
          .filter((grupo) => grupo.fases.length > 0);

        return (
          <div class="equipo-bloque">
            {competiciones.length > 0 && (
              <p class="competicion-label">
                {competiciones.map((c) => c.nombre).join(" · ")}
              </p>
            )}

            <PlantillaPanel plantilla={plantilla} entrenadores={entrenadores} />

            <CalendarioPanel
              todosPartidos={todosPartidos}
              nombreEquipo={nombreEquipo}
            />

            <ClasificacionPanel
              fasesPorCompeticion={fasesPorCompeticion}
              equipoId={equipo.id}
              nombreEquipo={nombreEquipo}
              participantesPorFase={participantesPorFase}
              clasificacionPorFase={clasificacionPorFase}
            />
          </div>
        );
      })
    }
  </div>
</Layout>
