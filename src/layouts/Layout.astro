---
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/nav/Nav.astro";
import { ClientRouter } from "astro:transitions";
const { titulo } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Sitio web oficial del CB Jaca. Calendario, resultados, noticias y toda la información del club de baloncesto."
    />
    <title>{titulo} · CB Jaca</title>
    <link rel="shortcut icon" href="/escudo-naranja.png" type="image/x-icon" />
    <ClientRouter />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  // Aplica el tema guardado lo antes posible para evitar parpadeo en cada
  // navegación. El toggle del botón vive en <ThemeToggle />.
  function aplicarTemaGuardado() {
    const html = document.documentElement;
    if (!html.getAttribute("data-theme")) {
      const guardado = localStorage.getItem("tema") || "light";
      html.setAttribute("data-theme", guardado);
    }
  }

  aplicarTemaGuardado();
  document.addEventListener("astro:page-load", aplicarTemaGuardado);

  if (!window.__astroNavDirTracked) {
    window.__astroNavDirTracked = true;
    document.addEventListener("astro:before-swap", (event) => {
      sessionStorage.setItem(
        "astro-nav-direction",
        event.direction === "back" ? "back" : "forward",
      );
    });
  }
</script>
